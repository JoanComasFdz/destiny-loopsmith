{
  "name": "loopsmith-e2e-recordings",
  "displayName": "Loopsmith e2e recordings",
  "description": "Shows each Loopsmith e2e scenario's recordings next to its code: a CodeLens, a play button and a panel that plays the MP4.",
  "version": "0.3.0",
  "publisher": "loopsmith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoanComasFdz/destiny-loopsmith"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Visualization"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "loopsmith.e2eRecordings.playHere",
        "title": "Loopsmith: Play e2e recording of this scenario",
        "icon": "$(play-circle)"
      },
      {
        "command": "loopsmith.e2eRecordings.refresh",
        "title": "Loopsmith: Refresh e2e recordings"
      },
      {
        "command": "loopsmith.e2eRecordings.signIn",
        "title": "Loopsmith: Sign in to GitHub to read e2e recordings"
      },
      {
        "command": "loopsmith.e2eRecordings.play",
        "title": "Loopsmith: Play e2e recording"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loopsmith.e2eRecordings.play",
          "when": "false"
        },
        {
          "command": "loopsmith.e2eRecordings.playHere",
          "when": "editorLangId == csharp"
        }
      ],
      "editor/title": [
        {
          "command": "loopsmith.e2eRecordings.playHere",
          "when": "resourceLangId == csharp && resource =~ /\\/(Scenarios|Rules)\\/.*Tests\\.cs$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Loopsmith e2e recordings",
      "properties": {
        "loopsmith.e2eRecordings.repository": {
          "type": "string",
          "default": "JoanComasFdz/destiny-loopsmith",
          "description": "The GitHub repository (owner/name) whose releases hold the e2e recordings."
        },
        "loopsmith.e2eRecordings.release": {
          "type": "string",
          "default": "prs-resources",
          "description": "The release's tag for the scenarios under Scenarios/: the \"E2E videos\" workflow uploads their recordings to it. A rule scenario's (under Rules/) are in its rule group's release, rules-<group>-resources."
        }
      }
    }
  }
}
