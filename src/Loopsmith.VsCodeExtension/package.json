{
  "name": "loopsmith-e2e-recordings",
  "displayName": "Loopsmith e2e recordings",
  "description": "Shows each Loopsmith e2e scenario's recordings next to its code: a CodeLens, a hover and a panel that plays the MP4.",
  "version": "0.1.0",
  "publisher": "loopsmith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoanComasFdz/destiny-loopsmith"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Visualization"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "loopsmith.e2eRecordings.refresh",
        "title": "Loopsmith: Refresh e2e recordings"
      },
      {
        "command": "loopsmith.e2eRecordings.signIn",
        "title": "Loopsmith: Sign in to GitHub to read e2e recordings"
      },
      {
        "command": "loopsmith.e2eRecordings.play",
        "title": "Loopsmith: Play e2e recording"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loopsmith.e2eRecordings.play",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Loopsmith e2e recordings",
      "properties": {
        "loopsmith.e2eRecordings.repository": {
          "type": "string",
          "default": "JoanComasFdz/destiny-loopsmith",
          "description": "The GitHub repository (owner/name) whose release holds the e2e recordings."
        },
        "loopsmith.e2eRecordings.release": {
          "type": "string",
          "default": "prs-resources",
          "description": "The release's tag: the \"E2E videos\" workflow uploads every recording to it."
        }
      }
    }
  }
}
