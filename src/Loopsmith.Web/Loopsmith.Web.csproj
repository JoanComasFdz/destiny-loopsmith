<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Web host (Blazor WebAssembly, static files): owns no game logic. It reads the embedded rule,
       build and loop files once at startup (impure), then calls the pure Orchestration API. -->
  <PropertyGroup>
    <RootNamespace>Loopsmith.Web</RootNamespace>
    <AssemblyName>Loopsmith.Web</AssemblyName>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Smaller first load: no time-zone database (the app shows no local times). -->
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <LoopsmithRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</LoopsmithRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Dunet" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loopsmith.Core\Loopsmith.Core.csproj" />
  </ItemGroup>

  <!-- Blazor trims only framework assemblies by default. The core is mostly generated code (Dunet matchers,
       Vogen converters) the app never calls and it uses no reflection, so trim it too (1.3 MB -> 516 KB when added). -->
  <ItemGroup>
    <TrimmableAssembly Include="Loopsmith.Core" />
  </ItemGroup>

  <!-- Bundled data, read at startup as SourceTexts. Logical names always use forward slashes:
       rules/<path>, builds/<slug>/build.yaml, builds/<slug>/loops/<name>.loop.yaml (folder optional). -->
  <ItemGroup>
    <EmbeddedResource Include="$(LoopsmithRoot)rules/**/*.yaml"
                      LogicalName="$([System.String]::Copy('rules/%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))"
                      Link="data/rules/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(LoopsmithRoot)builds/*/build.yaml;$(LoopsmithRoot)builds/*/loops/*.loop.yaml"
                      LogicalName="$([System.String]::Copy('builds/%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))"
                      Link="data/builds/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
