@page "/"
@implements IDisposable
@inject Workbench Workbench
@inject BrowserInterop Browser
@inject NavigationManager Navigation
@inject BungieManifestJoining Manifest

@* The start screen (the logo leads here): continue the open loop, start one from scratch (an Arc Hunter with nothing
   equipped) or from a build.yaml, or import a loop. Opening anything goes to the designer. A share link (…/#loop=) lands
   here and opens its loop the same way. *@

<PageTitle>Loopsmith</PageTitle>

<NoticeBanner Floating="true" Notice="Workbench.Notice" OnDismiss="() => Workbench.Notice = Optional.None<string>()" />

<section class="chooser" data-testid="chooser">
    <div class="chooser-intro">
        <h1>Design a build's gameplay loop</h1>
        <p class="muted">Start from scratch or import a build, then pick triggers — dodge, throw a grenade and kill, shoot, pick up an orb. Each step shows everything it fires, which element caused it, and what it unlocks next. The loop you design is the thing you export and share.</p>
    </div>

    @if (Workbench.Session is Optional<DesignSession>.Some { Value: var open })
    {
        var steps = open.Design.Steps.Length;
        <div class="build-cards">
            <a class="build-card continue" href="designer" data-testid="continue">
                <span class="build-card-sub">Your loop</span>
                <span class="build-card-name">@open.Design.Name</span>
                <span class="build-card-sub">@open.Build.Build.Name · @steps step@(steps == 1 ? "" : "s")</span>
                <span class="build-card-go">Continue designing →</span>
            </a>
        </div>
    }

    <button type="button" class="btn scratch-start" @onclick="StartFromScratchAsync" data-action="scratch-start">
        <span class="scratch-start-title">Start from scratch</span>
        <span class="scratch-start-sub">An Arc Hunter with nothing equipped: pick its super, abilities, aspects and fragments in the designer, and its weapons and armor from every item in the game (or your own, after logging in with Bungie).</span>
    </button>

    <p class="chooser-more muted" data-testid="import-links">
        Or
        <label class="btn link file-link" data-testid="import-build-link" title="Start from your own build.yaml (docs/rule-format.md)">
            import a build.yaml<InputFile OnChange="ImportBuildAsync" accept=".yaml,.yml" data-action="import-build" />
        </label>
        — or <button class="btn link" @onclick="OpenImportDialog">import a loop</button> (a <code>.loop.yaml</code> file or its YAML).
    </p>
</section>

@if (importing)
{
    <Modal Title="Import a loop" OnClose="CloseImportDialog">
        <ImportLoopForm Problem="importProblem" OnImport="ImportLoopAsync" OnUnreadable="ShowImportProblem" />
    </Modal>
}

@code {
    private bool importing;
    private Optional<string> importProblem = Optional.None<string>();

    [CascadingParameter]
    public LoopsmithBundle Bundle { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OpenSharedLoopOnNavigation;
        await OpenSharedLoopAsync(Navigation.Uri);
    }

    public void Dispose() =>
        Navigation.LocationChanged -= OpenSharedLoopOnNavigation;

    private async Task ImportBuildAsync(InputFileChangeEventArgs e)
    {
        var proceed = await DiscardConfirming.ConfirmDiscardAsync(Workbench, Browser, "Start a new loop from this build?"); // impure
        if (!proceed)
        {
            return;
        }

        var text = await BrowserInterop.ReadPickedFileAsync(e.File);                             // impure
        var file = text.Map(value => new SourceText(e.File.Name, value));                        // pure
        var unknown = file.Match(ok => LoopDesigning.ListUnknownBuildFileHashes(Bundle.Catalog, ok.Value), _ => []); // pure
        var catalog = await JoinManifestAsync(Bundle.Catalog, unknown);                          // impure

        var started = file.Bind(read => BundleComposing.StartNamedDesign(catalog.Catalog, read)); // pure
        var note = catalog.Note.Match(problem => $" {problem.Value}", _ => "");                  // pure
        var message = started.Match(ok => $"New loop for {ok.Value.Build.Build.Name}.{note}", error => $"{error.Failure}{note}"); // pure
        started.Match(                                                                           // impure
            ok => OpenDesign(ok.Value, message),
            _ => ShowNotice(message));
    }

    /// <summary>A new loop for a build with nothing equipped (an Arc Hunter), opened in the designer.</summary>
    private async Task StartFromScratchAsync()
    {
        var proceed = await DiscardConfirming.ConfirmDiscardAsync(Workbench, Browser, "Start a new loop from scratch?"); // impure
        if (!proceed)
        {
            return;
        }

        var started = LoopDesigning.StartScratchDesign(Bundle.Catalog);                          // pure
        started.Match(                                                                           // impure
            ok => OpenDesign(ok.Value, $"New loop from scratch, for an {ok.Value.Build.Build.Name} with nothing equipped yet: ⋯ on the Subclass box picks its abilities."),
            error => ShowNotice(error.Failure));
    }

    /// <summary>The catalog with what Bungie's full manifest says of these hashes (none: as it is); a note when it couldn't be read.</summary>
    private async Task<JoinedCatalog> JoinManifestAsync(RuleCatalog catalog, ImmutableArray<ItemHash> unknown)
    {
        if (unknown.IsEmpty)
        {
            return new JoinedCatalog(catalog, Optional.None<string>());
        }

        var joined = await Manifest.JoinAsync(unknown, ManifestReadFor.BuildItems);              // impure
        return LoopDesigning.AddJoinedManifest(catalog, joined);                                 // pure
    }

    private void OpenImportDialog()
    {
        importProblem = Optional.None<string>();
        importing = true;
    }

    private void CloseImportDialog() =>
        importing = false;

    private void ShowImportProblem(string problem) =>
        importProblem = Optional.Some(problem);

    private async Task ImportLoopAsync(SourceText file)
    {
        var unknown = LoopDesigning.ListUnknownLoopFileHashes(Bundle.Catalog, file);             // pure
        var catalog = await JoinManifestAsync(Bundle.Catalog, unknown);                          // impure
        var imported = LoopDesigning.ImportLoop(catalog.Catalog, file);                          // pure
        var note = catalog.Note.Match(problem => $" {problem.Value}", _ => "");                  // pure
        if (imported is Result<DesignSession, string>.Error error)
        {
            var problem = error.Failure + note;                                                  // pure
            importProblem = Optional.Some(problem);                                              // impure (UI state)
            return;
        }

        var proceed = await DiscardConfirming.ConfirmDiscardAsync(Workbench, Browser, "Open this loop?"); // impure
        if (proceed && imported is Result<DesignSession, string>.Ok ok)
        {
            importing = false;
            OpenDesign(ok.Value, $"Imported “{ok.Value.Design.Name}”.");
        }
    }

    private async Task OpenSharedLoopAsync(string uri)
    {
        var payload = ShareLinkCoding.ReadLoopPayload(uri);                                      // pure
        if (payload is not Optional<string>.Some some)
        {
            return;
        }

        var decoded = ShareLinkCoding.DecodeLoopPayload(some.Value)                              // pure
            .Map(file => new SourceText("shared.loop.yaml", file));
        var unknown = decoded.Match(ok => LoopDesigning.ListUnknownLoopFileHashes(Bundle.Catalog, ok.Value), _ => []); // pure
        var catalog = await JoinManifestAsync(Bundle.Catalog, unknown);                          // impure
        var imported = decoded.Bind(file => LoopDesigning.ImportLoop(catalog.Catalog, file));    // pure
        var note = catalog.Note.Match(problem => $" {problem.Value}", _ => "");                  // pure
        var message = imported.Match(                                                            // pure
            ok => $"Opened the shared loop “{ok.Value.Design.Name}”.{note}",
            error => $"Couldn't open the shared loop:{Environment.NewLine}{error.Failure}{note}");
        await Browser.ClearLocationHashAsync();                                                  // impure
        imported.Match(                                                                          // impure
            ok => OpenDesign(ok.Value, message),
            _ => ShowNotice(message));
    }

    private void OpenSharedLoopOnNavigation(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await OpenSharedLoopAsync(e.Location);                                               // impure
            StateHasChanged();
        });

    /// <summary>The design becomes the open one and the designer shows it.</summary>
    private Unit OpenDesign(DesignSession session, string message)
    {
        Workbench.OpenSession(session);
        Workbench.Notice = Optional.None<string>();
        Workbench.Status = message + DescribeCatalogMismatch(session);
        Navigation.NavigateTo("designer");                                                        // impure
        return new Unit.Value();
    }

    private Unit ShowNotice(string message)
    {
        Workbench.Notice = Optional.Some(message);
        return new Unit.Value();
    }

    /// <summary>" (Loop designed against catalog …; replaying with ….)" when the loop came from another catalog.</summary>
    private static string DescribeCatalogMismatch(DesignSession session) =>
        LoopDesigning.FindCatalogMismatch(session).Match(issue => $" {issue.Value.Message}", _ => "");
}
