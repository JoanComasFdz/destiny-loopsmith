@page "/compare"
@inject Workbench Workbench

<PageTitle>Compare · Loopsmith</PageTitle>

@{
    var choices = ComparisonPicking.ListChoices(Bundle, Workbench.Session, Workbench.ImportedLoops);
}
<section class="page-head">
    <div>
        <h1>Compare loops</h1>
        <p class="muted">Pick a loop for each side — the one in the designer, an example, or a <code>.loop.yaml</code> you import. Each loop is played from a fresh spawn and then again from where it ends; the comparison lines their triggers up, so you see how each one's place in the order changes what it needs and sets off. The loops may use different builds.</p>
    </div>
</section>

@if (status.Length > 0)
{
    <p class="status" role="status" data-testid="status">@status</p>
}

@if (Workbench.ComparePicks is not Optional<ComparisonPicks>.Some { Value: var picks })
{
    <section class="panel empty-state">
        <h2>Nothing to compare yet</h2>
        <p class="muted">Import a <code>.loop.yaml</code>, or design a loop first.</p>
        <div class="toolbar-group">
            <button class="btn primary" @onclick="() => OpenImportDialog(CompareSide.Left)" data-action="import-left">Import a .loop.yaml</button>
            <a class="btn" href="">Open the designer</a>
        </div>
    </section>
}
else
{
    <div class="compare-pickers">
        @RenderPicker(choices, picks.LeftId, CompareSide.Left)
        <span class="versus" aria-hidden="true">vs</span>
        @RenderPicker(choices, picks.RightId, CompareSide.Right)
    </div>

    @if (view is Optional<ComparisonView>.Some compared)
    {
        <section class="panel comparison" aria-label="Comparison">
            @if (compared.Value.Comparison is Optional<LoopComparison>.Some comparison)
            {
                var leftReport = comparison.Value.Left;
                var rightReport = comparison.Value.Right;
                <div class="compare-orders" data-testid="orders">
                    @RenderOrder("A", leftReport)
                    @RenderOrder("B", rightReport)
                </div>
                <div class="compare-chains" data-testid="chains">
                    <div class="compare-chain">
                        <h3 class="section-label">A · @leftReport.LoopName</h3>
                        <StepChain Report="leftReport" Links="comparison.Value.LeftLinks" />
                    </div>
                    <div class="compare-chain">
                        <h3 class="section-label">B · @rightReport.LoopName</h3>
                        <StepChain Report="rightReport" Links="comparison.Value.RightLinks" />
                    </div>
                </div>
                <p class="muted chain-legend">Arrows: which step feeds which. Dashed comes from the pass before; faded and dotted only by chance; highlighted when the other loop doesn't have it.</p>
                <div class="table-wrap">
                    <table class="data-table compare-table">
                        <thead>
                            <tr>
                                <th>Trigger</th>
                                <th>A · @leftReport.LoopName</th>
                                <th>B · @rightReport.LoopName</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trigger in comparison.Value.Triggers)
                            {
                                <tr>
                                    <td>@trigger.Label</td>
                                    @switch (trigger.Placement)
                                    {
                                        case TriggerPlacement.InBoth both:
                                            <td>@RenderStepCell(both.Left, both.OnlyLeft)</td>
                                            <td>@RenderStepCell(both.Right, both.OnlyRight)</td>
                                            break;
                                        case TriggerPlacement.OnlyInLeft left:
                                            <td>@RenderStepCell(left.Step, ImmutableArray<ElementMention>.Empty)</td>
                                            <td><span class="muted">not in this loop</span></td>
                                            break;
                                        case TriggerPlacement.OnlyInRight right:
                                            <td><span class="muted">not in this loop</span></td>
                                            <td>@RenderStepCell(right.Step, ImmutableArray<ElementMention>.Empty)</td>
                                            break;
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <details class="report-text">
                    <summary>The comparison as text (same as <code>loopsmith compare</code>)</summary>
                    <StyledLines Lines="@LoopDesigning.RenderLoopComparison(comparison.Value)" Preformatted="true" />
                </details>
            }
            else
            {
                <p class="notice warn">Both loops must open before they can be compared.</p>
            }
        </section>

        <div class="compare-columns">
            @RenderSide(compared.Value.Left, "Left")
            @RenderSide(compared.Value.Right, "Right")
        </div>
    }
}

@if (importSide is Optional<CompareSide>.Some side)
{
    <Modal Title="@($"Import a loop · {DescribeSide(side.Value)}")" OnClose="CloseImportDialog">
        <p class="muted">A <code>.loop.yaml</code> carries its own build, so it replays here as it was designed. It stays on this screen until you close the tab — nothing is stored.</p>
        <ImportLoopForm Problem="importProblem" OnImport="ImportLoop" OnUnreadable="ShowImportProblem" />
    </Modal>
}

@code {
    private enum CompareSide { Left, Right }

    private Optional<ComparisonView> view = Optional.None<ComparisonView>();
    private Optional<CompareSide> importSide = Optional.None<CompareSide>();
    private Optional<string> importProblem = Optional.None<string>();
    private string status = "";

    [CascadingParameter]
    public LoopsmithBundle Bundle { get; set; } = null!;

    protected override void OnInitialized() =>
        CompareLoops(Workbench.ComparePicks);

    private void PickLoop(CompareSide side, ChangeEventArgs e)
    {
        var id = e.Value?.ToString() ?? "";
        status = "";
        CompareLoops(Workbench.ComparePicks.Map(picks => SetSide(picks, side, id)));
    }

    /// <summary>Keeps the picks that are still offered (see <see cref="ComparisonPicking.PickIds"/>) and compares them.</summary>
    private void CompareLoops(Optional<ComparisonPicks> wanted)
    {
        var choices = ComparisonPicking.ListChoices(Bundle, Workbench.Session, Workbench.ImportedLoops); // pure
        var picks = ComparisonPicking.PickIds(choices, wanted);                                       // pure
        Workbench.ComparePicks = picks;
        view = picks.Map(picked => ComparisonPicking.CompareChoices(choices, picked));                // pure
    }

    private void OpenImportDialog(CompareSide side)
    {
        importProblem = Optional.None<string>();
        importSide = Optional.Some(side);
    }

    private void ImportLoop(SourceText file)
    {
        var imported = LoopDesigning.ImportLoop(Bundle.Catalog, file);                               // pure
        imported.Match(
            ok => KeepImportedLoop(ok.Value),
            error =>
            {
                importProblem = Optional.Some(error.Failure);
                return new Unit.Value();
            });
    }

    private Unit KeepImportedLoop(DesignSession session)
    {
        var side = importSide.UnwrapOr(CompareSide.Left);
        var (loops, id) = ComparisonPicking.AddImportedLoop(Workbench.ImportedLoops, session);        // pure
        Workbench.ImportedLoops = loops;
        importSide = Optional.None<CompareSide>();
        status = $"Imported “{session.Design.Name}” for the {DescribeSide(side).ToLowerInvariant()} side.";
        var wanted = Workbench.ComparePicks
            .Map(picks => SetSide(picks, side, id))
            .UnwrapOr(new ComparisonPicks(id, id));
        CompareLoops(Optional.Some(wanted));
        return new Unit.Value();
    }

    private void ShowImportProblem(string problem) =>
        importProblem = Optional.Some(problem);

    private void CloseImportDialog() =>
        importSide = Optional.None<CompareSide>();

    private static ComparisonPicks SetSide(ComparisonPicks picks, CompareSide side, string id) =>
        side == CompareSide.Left ? picks with { LeftId = id } : picks with { RightId = id };

    private static string DescribeSide(CompareSide side) =>
        side == CompareSide.Left ? "Left" : "Right";

    private static string DescribeOrigin(ChoiceOrigin origin) =>
        origin switch
        {
            ChoiceOrigin.Current => "In the designer",
            ChoiceOrigin.Example => "Example loops",
            _ => "Imported this session",
        };

    private RenderFragment RenderPicker(ImmutableArray<ComparisonChoice> choices, string pickedId, CompareSide side) => __builder =>
    {
        var label = DescribeSide(side);
        <div class="compare-picker" data-side="@label.ToLowerInvariant()">
            <label class="field">
                <span class="field-label">@label</span>
                <select value="@pickedId" @onchange="e => PickLoop(side, e)" aria-label="@($"{label} loop")">
                    @foreach (var group in choices.GroupBy(choice => choice.Origin))
                    {
                        <optgroup label="@DescribeOrigin(group.Key)">
                            @foreach (var choice in group)
                            {
                                <option value="@choice.Id">@choice.Label</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>
            <button class="btn" @onclick="() => OpenImportDialog(side)" data-action="@($"import-{label.ToLowerInvariant()}")">Import a .loop.yaml</button>
        </div>
    };

    private static RenderFragment RenderOrder(string side, LoopReport report) => __builder =>
    {
        <p class="compare-order">
            <span class="muted">@side</span>
            <strong>@report.LoopName</strong>
            <span>@string.Join(" → ", report.StepLabels)</span>
            <span class="badge @(report.Verdict is LoopVerdict.Repeats ? "ok" : "warn")">@report.Verdict.DescribeShortVerdict()</span>
        </p>
    };

    /// <summary>A trigger's step in one loop: its number, where its needs come from, what fires only there.</summary>
    private static RenderFragment RenderStepCell(PlacedStep placed, ImmutableArray<ElementMention> onlyHere) => __builder =>
    {
        var analysed = placed.Step;
        <div class="compare-cell">
            <span class="muted">#@(analysed.StepIndex + 1)</span>
            @if (analysed.Blocked is Optional<string>.Some blocked)
            {
                <span class="tone-warning">blocked: @blocked.Value</span>
            }
            @if (analysed.Needs.IsEmpty)
            {
                <span class="muted">needs nothing from earlier steps</span>
            }
            else
            {
                <span class="chips">
                    @foreach (var need in analysed.Needs)
                    {
                        <span class="chip @ToneStyling.ToAffinityClass(need.Affinity)">@need.DescribeNeedBriefly()</span>
                    }
                </span>
            }
            @if (!onlyHere.IsEmpty)
            {
                <span class="tone-warning">only here: @string.Join(", ", onlyHere.Select(element => element.DescribeMention()))</span>
            }
            @if (placed.DiffersOnFirstPass)
            {
                <span class="muted">differs on the first pass</span>
            }
        </div>
    };

    private static RenderFragment RenderSide(ComparedLoop side, string label) => __builder =>
    {
        <section class="panel compare-side" aria-label="@label">
            @switch (side.Design)
            {
                case Result<DesignSession, string>.Ok opened:
                    var session = opened.Value;
                    var glossary = session.Build.Catalog.Glossary;
                    <header class="panel-head">
                        <h2>@session.Design.Name</h2>
                        <span class="panel-caption">@label</span>
                    </header>
                    <p class="muted">@session.Build.Build.Name · @session.Build.Build.Class · @session.Build.Build.Subclass</p>
                    @if (side.Report is Optional<LoopReport>.Some report)
                    {
                        <p>
                            <span class="badge @(report.Value.Verdict is LoopVerdict.Repeats ? "ok" : "warn")" data-testid="verdict">@report.Value.Verdict.DescribeShortVerdict()</span>
                        </p>
                    }
                    <ol class="step-list">
                        @foreach (var step in session.Design.Steps)
                        {
                            <li>
                                <span class="step-list-title">@glossary.DescribeAction(step.Action, session.Build.Build)</span>
                                <code class="token">@step.Action.ToActionToken()</code>
                                @if (step.Note is Optional<string>.Some note)
                                {
                                    <span class="step-list-note">@note.Value</span>
                                }
                            </li>
                        }
                    </ol>
                    @if (session.Design.Steps.IsEmpty)
                    {
                        <p class="muted">No steps.</p>
                    }
                    break;
                case Result<DesignSession, string>.Error failed:
                    <header class="panel-head"><h2>Cannot open</h2><span class="panel-caption">@label</span></header>
                    <pre class="entry-problem">@failed.Failure</pre>
                    break;
            }
        </section>
    };
}
