@page "/designer"
@inject Workbench Workbench
@inject BrowserInterop Browser
@inject NavigationManager Navigation

<PageTitle>@DescribePageTitle() · Loopsmith</PageTitle>

<NoticeBanner />

@if (Workbench.Session is Optional<DesignSession>.Some { Value: var session })
{
    var shown = ReadShownState(session);
    var stepCount = session.Design.Steps.Length;
    <div class="designer">
        <section class="panel loop-header" aria-label="Loop">
            <div class="loop-header-row">
                <div class="build-identity" data-testid="build-identity">
                    <span class="field-label">Build</span>
                    <span class="build-identity-name">@session.Build.Build.Name</span>
                    @if (session.Build.Build.SourceUrl is Optional<string>.Some source)
                    {
                        <a class="build-identity-link" href="@source.Value" target="_blank" rel="noopener noreferrer"
                           title="@source.Value" data-testid="build-source">
                            <span class="build-identity-kind">@(LoopDesigning.IsDimLink(source.Value) ? "DIM link" : "Source")</span>
                            <span class="build-identity-url">@source.Value</span>
                        </a>
                    }
                </div>
                <a class="btn" href="" title="Start from another DIM link or build" data-action="change-build">Change build</a>
            </div>
            <div class="loop-fields">
                <label class="field grow">
                    <span class="field-label">Loop name</span>
                    <input class="loop-name" value="@session.Design.Name" @onchange="RenameLoop" aria-label="Loop name" />
                </label>
                <label class="field">
                    <span class="field-label">Author</span>
                    <input class="loop-author" value="@session.Design.Author.UnwrapOr("")" @onchange="ChangeAuthor" placeholder="you" aria-label="Author" />
                </label>
                <label class="field full">
                    <span class="field-label">Description</span>
                    <textarea class="loop-description" rows="2" value="@session.Design.Description.UnwrapOr("")" @onchange="ChangeDescription"
                              placeholder="How do you play this loop? What does it feed?" aria-label="Description"></textarea>
                </label>
            </div>
        </section>

        <div class="toolbar" role="toolbar" aria-label="Loop actions">
            <div class="toolbar-group">
                <button class="btn" disabled="@(stepCount == 0)" @onclick="UndoLastStep" title="Remove the last step" data-action="undo">↶ Undo</button>
                <button class="btn" disabled="@(stepCount == 0)" @onclick="() => ResetLoopAsync(session)" title="Clear every step" data-action="reset">Reset</button>
            </div>
            <div class="toolbar-group">
                <button class="btn primary" @onclick="AnalyzeLoop" data-action="analyze">Analyze</button>
                <button class="btn" @onclick="ExportLoopAsync" data-action="export">Export</button>
                <button class="btn" @onclick="CopyShareLinkAsync" data-action="share">Copy share link</button>
            </div>
        </div>
        @if (Workbench.Status.Length > 0)
        {
            <p class="status" role="status" data-testid="status">@Workbench.Status</p>
        }

        <div class="designer-grid">
            <aside class="col-build">
                <BuildPanel Build="session.Build" Issues="LoopDesigning.ListDesignIssues(session)" />
            </aside>
            <div class="col-loop">
                <ExplainPanel Build="session.Build" />
                <div class="timeline-tools">
                    <h2>Loop <span class="muted">· @stepCount step@(stepCount == 1 ? "" : "s")</span></h2>
                    <div class="timeline-toggles">
                        <label class="toggle" title="Show each rule's reason text"><input type="checkbox" checked="@traceOptions.ShowReasons" @onchange="ToggleReasons" /> why</label>
                        <label class="toggle" title="Show each outcome's caveats: unknown amounts, a buff already active, extra stacks, nothing to consume, where a pickup lands"><input type="checkbox" checked="@traceOptions.ShowCaveats" @onchange="ToggleCaveats" /> caveats</label>
                    </div>
                </div>
                <LoopTimeline Session="session" Selected="Workbench.SelectedStep" Options="traceOptions"
                              OnSelect="SelectStep" OnBranch="BranchFromStep" OnAnnotate="AnnotateStep" />
            </div>
            <aside class="col-side">
                <TriggerPalette Build="session.Build" Options="LoopDesigning.ListTriggerOptions(session)" OnPick="AppendTrigger"
                                Caption="@(stepCount == 0 ? "from a fresh spawn" : $"after #{stepCount}")"
                                Hint="@DescribePaletteHint(shown.Number, stepCount)" />
                <StatePanel Build="session.Build" State="shown.State" Passives="shown.Passives" Caption="@shown.Caption" />
            </aside>
        </div>
    </div>

    @switch (dialog)
    {
        case DesignerDialog.ShareLink:
            <Modal Title="Share link" OnClose="CloseDialog">
                <p class="@(shareCopied ? "tone-strong" : "tone-warning")" data-testid="share-status">
                    @(shareCopied ? "Copied to the clipboard." : "Could not copy automatically — copy the link below.")
                </p>
                <input class="code-input share-url" readonly value="@shareUrl" aria-label="Share link" data-testid="share-url" @onfocus="SelectShareUrlAsync" @ref="shareInput" />
                <p class="muted">The whole loop (steps, notes and its build) is in the link's <code>#loop=</code> fragment — nothing is sent to a server. @shareUrl.Length characters.</p>
            </Modal>
            break;
        case DesignerDialog.Analysis when report is Optional<LoopReport>.Some analyzed:
            <Modal Title="Loop analysis" Size="wide" OnClose="CloseDialog">
                <AnalysisView Report="analyzed.Value" />
            </Modal>
            break;
    }
}

@code {
    private enum DesignerDialog { None, ShareLink, Analysis }

    private sealed record ShownState(int Number, GameState State, ImmutableArray<ActivePassive> Passives, string Caption);

    private TraceOptions traceOptions = new(false, false, false);
    private DesignerDialog dialog = DesignerDialog.None;
    private Optional<LoopReport> report = Optional.None<LoopReport>();
    private string shareUrl = "";
    private bool shareCopied;
    private Optional<int> scrollToStep = Optional.None<int>();
    private ElementReference shareInput;

    /// <summary>The designer shows the open loop; with none open, Home is where one is picked.</summary>
    protected override void OnInitialized()
    {
        if (!Workbench.Session.IsSome())
        {
            Navigation.NavigateTo("", replace: true);                                            // impure
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToStep is Optional<int>.Some step)
        {
            scrollToStep = Optional.None<int>();
            await Browser.RevealElementAsync($"step-{step.Value}");                              // impure
        }
    }

    // ── editing the loop ────────────────────────────────────────────────────────

    private void AppendTrigger(PlayerAction action) =>
        EditSession(session => LoopDesigning.AppendStep(session, action, Optional.None<string>()), scrollToEnd: true);

    private void UndoLastStep() =>
        EditSession(LoopDesigning.RemoveLastStep, scrollToEnd: false);

    private async Task ResetLoopAsync(DesignSession session)
    {
        var proceed = await DiscardConfirming.ConfirmDiscardAsync(Workbench, Browser, "Reset the loop?"); // impure
        if (proceed)
        {
            EditSession(current => LoopDesigning.TruncateSteps(current, 0), scrollToEnd: false);
        }
    }

    private void BranchFromStep(int number) =>
        EditSession(session => LoopDesigning.TruncateSteps(session, number), scrollToEnd: false);

    private void AnnotateStep((int Index, string Note) edit) =>
        EditSession(session => LoopDesigning.AnnotateStep(session, edit.Index, ToOptionalText(edit.Note)), scrollToEnd: false, keepSelection: true);

    private void RenameLoop(ChangeEventArgs e) =>
        EditSession(session => LoopDesigning.RenameDesign(session, ToLoopName(e.Value), session.Design.Author, session.Design.Description),
            scrollToEnd: false, keepSelection: true);

    private void ChangeAuthor(ChangeEventArgs e) =>
        EditSession(session => LoopDesigning.RenameDesign(session, session.Design.Name, ToOptionalText(e.Value?.ToString() ?? ""), session.Design.Description),
            scrollToEnd: false, keepSelection: true);

    private void ChangeDescription(ChangeEventArgs e) =>
        EditSession(session => LoopDesigning.RenameDesign(session, session.Design.Name, session.Design.Author, ToOptionalText(e.Value?.ToString() ?? "")),
            scrollToEnd: false, keepSelection: true);

    private void SelectStep(int number) =>
        Workbench.SelectedStep = Workbench.SelectedStep.Match(some => some.Value == number, _ => false)
            ? Optional.None<int>()
            : Optional.Some(number);

    /// <summary>Applies a pure edit to the open design (every edit is a new immutable session).</summary>
    private void EditSession(Func<DesignSession, DesignSession> edit, bool scrollToEnd, bool keepSelection = false)
    {
        if (Workbench.Session is not Optional<DesignSession>.Some open)
        {
            return;
        }

        var next = edit(open.Value);                                                             // pure
        Workbench.Session = Optional.Some(next);
        Workbench.SelectedStep = keepSelection ? Workbench.SelectedStep : Optional.None<int>();
        report = Optional.None<LoopReport>();
        Workbench.Status = "";
        scrollToStep = scrollToEnd ? Optional.Some(next.Design.Steps.Length) : Optional.None<int>();
    }

    private void ToggleReasons(ChangeEventArgs e) =>
        traceOptions = traceOptions with { ShowReasons = e.Value is true };

    private void ToggleCaveats(ChangeEventArgs e) =>
        traceOptions = traceOptions with { ShowCaveats = e.Value is true };

    // ── toolbar: analyze, export, share ─────────────────────────────────────────

    private void AnalyzeLoop()
    {
        if (Workbench.Session is Optional<DesignSession>.Some open)
        {
            report = Optional.Some(LoopDesigning.AnalyzeDesign(open.Value)); // pure
            dialog = DesignerDialog.Analysis;
        }
    }

    private async Task ExportLoopAsync()
    {
        if (Workbench.Session is not Optional<DesignSession>.Some open)
        {
            return;
        }

        var file = LoopDesigning.ExportLoop(open.Value);                                         // pure
        var fileName = LoopFileNaming.ToLoopFileName(open.Value.Design.Name);                    // pure
        await Browser.DownloadTextAsync(fileName, file);                                         // impure
        Workbench.Status = $"Exported {fileName}.";
    }

    private async Task CopyShareLinkAsync()
    {
        if (Workbench.Session is not Optional<DesignSession>.Some open)
        {
            return;
        }

        var file = LoopDesigning.ExportLoop(open.Value);                                         // pure
        var url = ShareLinkCoding.ToShareUrl(Navigation.BaseUri, file);                          // pure
        var copied = await Browser.CopyTextAsync(url);                                           // impure
        shareUrl = url;
        shareCopied = copied;
        dialog = DesignerDialog.ShareLink;
    }

    private async Task SelectShareUrlAsync() =>
        await shareInput.FocusAsync(preventScroll: true);                                        // impure

    private void CloseDialog() =>
        dialog = DesignerDialog.None;

    // ── reading for display ─────────────────────────────────────────────────────

    /// <summary>The state the right column shows: after the selected card, else after the last step.</summary>
    private ShownState ReadShownState(DesignSession session)
    {
        var count = session.Resolutions.Length;
        var number = Math.Clamp(Workbench.SelectedStep.UnwrapOr(count), 0, count);
        return number == 0
            ? new ShownState(0, session.Initial, [], "fresh spawn")
            : new ShownState(number, session.Resolutions[number - 1].State, session.Resolutions[number - 1].ActivePassives,
                number == count ? $"after #{number} · now" : $"after #{number}");
    }

    private static string DescribePaletteHint(int shownNumber, int stepCount) =>
        shownNumber < stepCount
            ? $"The state shows #{shownNumber}; new steps still go after #{stepCount}. Use “Branch from here” on #{shownNumber} to continue from there."
            : "";

    private string DescribePageTitle() =>
        Workbench.Session.Match(open => open.Value.Design.Name, _ => "Designer");

    private static Optional<string> ToOptionalText(string text) =>
        text.Trim().Length == 0 ? Optional.None<string>() : Optional.Some(text.Trim());

    private static string ToLoopName(object? value) =>
        ToOptionalText(value?.ToString() ?? "").UnwrapOr("Untitled loop");
}
