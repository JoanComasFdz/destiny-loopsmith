@* An item's details: Bungie's text and, for what the rules know, Loopsmith's rules (written from the Compendium or
   Clarity, with their source), section by section — an exotic weapon's intrinsic, perks and catalyst. *@
<Modal Title="@Info.Name" TitleUrl="Info.Page" OnClose="OnClose">
    <div class="item-info @ToneStyling.ToAffinityClass(Info.Affinity)" data-testid="item-info">
        <header class="item-info-head">
            @if (Info.Icon is Optional<string>.Some icon)
            {
                <img class="item-info-icon @DescribeTier(Info.Tier)" src="@icon.Value" alt="" />
            }
            <span class="item-info-type">@Info.TypeLine</span>
        </header>
        @foreach (var section in Info.Sections)
        {
            <section class="info-section">
                @switch (section)
                {
                    case InfoSection.Item item:
                        @RenderTexts(item.BungieText, item.Rules)
                        break;
                    case InfoSection.Perk perk:
                        @RenderHeading(perk.Heading)
                        @RenderTexts(perk.BungieText, perk.Rules)
                        break;
                    case InfoSection.Unpicked unpicked:
                        @RenderHeading(new SectionHeading(DomainPhrasing.Unknown, Optional.None<string>(), $"Trait · column {unpicked.Column + 1}"))
                        <p class="muted info-note">Not picked: a DIM link carries the weapon, not its roll.</p>
                        break;
                    case InfoSection.Catalyst catalyst:
                        @if (catalyst.Heading is Optional<SectionHeading>.Some heading)
                        {
                            @RenderHeading(heading.Value)
                        }
                        @RenderTexts(catalyst.BungieText, catalyst.Rules)
                        @if (OnSetCatalyst.HasDelegate)
                        {
                            <button type="button" class="btn catalyst-switch @(catalyst.Toggle.On ? "on" : "")" role="switch" aria-checked="@(catalyst.Toggle.On ? "true" : "false")"
                                    data-action="catalyst-toggle" @onclick="() => SetCatalystAsync(catalyst.Toggle)">
                                Catalyst @(catalyst.Toggle.On ? "on" : "off") — turn it @(catalyst.Toggle.On ? "off" : "on")
                            </button>
                        }
                        else
                        {
                            <p class="muted info-note">Catalyst @(catalyst.Toggle.On ? "on" : "off"). Turn it on or off while designing the loop.</p>
                        }
                        break;
                }
            </section>
        }
    </div>
</Modal>

@code {
    [Parameter, EditorRequired]
    public ItemInfo Info { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Set by the designer: the catalyst's switch turns it on or off. Unset (the Home card): it only says which.</summary>
    [Parameter]
    public EventCallback<CatalystToggle> OnSetCatalyst { get; set; }

    private async Task SetCatalystAsync(CatalystToggle current)
    {
        var toggled = current with { On = !current.On };                                         // pure
        await OnSetCatalyst.InvokeAsync(toggled);                                                // impure
    }

    private static RenderFragment RenderHeading(SectionHeading heading) => __builder =>
    {
        <h3 class="info-section-title">
            @if (heading.Icon is Optional<string>.Some icon)
            {
                <img class="info-section-icon" src="@icon.Value" alt="" />
            }
            <span>@heading.Name</span>
            <span class="info-label">@heading.Label</span>
        </h3>
    };

    private static RenderFragment RenderTexts(Optional<string> bungieText, Optional<InfoRules> rules) => __builder =>
    {
        @if (bungieText is Optional<string>.Some bungie)
        {
            <div class="info-card bungie" data-testid="info-bungie">
                <div class="info-source">Bungie</div>
                <p class="info-bungie">@bungie.Value</p>
            </div>
        }
        <div class="info-card rules" data-testid="info-rules">
            <div class="info-source">Loopsmith's rules</div>
            @if (rules is Optional<InfoRules>.Some known)
            {
                @if (known.Value.Description is Optional<string>.Some description)
                {
                    <p class="info-rules-text">@description.Value</p>
                }
                @if (known.Value.Explanation.IsEmpty)
                {
                    <p class="muted info-note">No rule is written for it yet: it sets nothing off in a loop.</p>
                }
                else
                {
                    @if (!known.Value.Equipped)
                    {
                        <p class="muted info-note" data-testid="not-equipped">Not in this build right now; what it would set off:</p>
                    }
                    <StyledLines Lines="known.Value.Explanation" />
                }
                <p class="info-cite">Source: @known.Value.Source</p>
            }
            else
            {
                <p class="muted info-note">Not in Loopsmith's rules yet: it sets nothing off in a loop.</p>
            }
        </div>
    };

    private static string DescribeTier(Optional<ItemTier> tier) =>
        tier.Match(known => known.Value == ItemTier.Exotic ? "exotic" : known.Value == ItemTier.Legendary ? "legendary" : "", _ => "");
}
