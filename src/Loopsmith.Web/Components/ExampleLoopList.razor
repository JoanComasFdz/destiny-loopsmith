@* The example loops that ship with the app, as a compact list (the designer's start screen shows them as cards).
   What opening one means is the host's decision (OnOpen). *@
<ul class="example-list">
    @foreach (var example in Loops)
    {
        <li>
            @if (example.Opened is Result<DesignSession, string>.Ok loop)
            {
                <button class="btn example-item" data-example="@example.File.Path" @onclick="() => OpenExample(example)">
                    <span class="example-name">@loop.Value.Design.Name</span>
                    <span class="muted">@loop.Value.Build.Build.Name · @loop.Value.Design.Steps.Length steps</span>
                </button>
            }
            else
            {
                <span class="example-item tone-warning">@example.File.Path.Split('/')[^1] does not import.</span>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public ImmutableArray<BundledLoop> Loops { get; set; }

    [Parameter]
    public EventCallback<BundledLoop> OnOpen { get; set; }

    private Task OpenExample(BundledLoop example) =>
        OnOpen.InvokeAsync(example);
}
