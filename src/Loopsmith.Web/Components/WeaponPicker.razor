@* The weapon picker for a slot of the build: the player's weapons for it (after their Bungie login), Bungie's icons,
   each with its tier, masterwork, breaker and element as DIM shows them. It opens showing the copy the build's weapon
   there wears; another weapon's perks show on hover (a mouse) or a first tap; a click on a weapon already showing (or
   "Use this weapon") picks it, and the designer swaps it into the build with its perks (LoopDesigning.PickWeapon).
   Picking the copy the build already wears just closes the picker. *@
@{
    var view = WeaponPickerShaping.ShapePicker(Build, LoopDesigning.ListWeaponOptions(Build, Profile, Target));
    var slot = Build.Build.FindTargetSlot(Target);
    var shown = view.Options.Where(option => focused == Optional.Some(option.Instance)).Select(Optional.Some).FindFirstSome();
}
<Modal Title="@view.Title" Size="wide fit" OnClose="OnClose">
    <div class="weapon-picker" data-testid="weapon-picker" data-slot="@slot.Match(found => found.Value.ToString(), _ => "")">
        <ManifestProgressBar />
        @if (view.Options.IsEmpty)
        {
            <p class="muted" data-testid="weapon-picker-empty">Your account has no @slot.Match(found => found.Value.DescribeWeaponSlot().ToLowerInvariant(), _ => "") weapon Loopsmith can list for it.</p>
        }
        else
        {
            <div class="icon-grid weapon-options" role="listbox" aria-label="@view.Title">
                @foreach (var option in view.Options)
                {
                    var instance = option.Instance;
                    <div class="weapon-option">
                        <button type="button" role="option" aria-selected="@(focused == Optional.Some(instance) ? "true" : "false")"
                                class="icon-tile tappable item @DescribeTier(option.Tile) @(option.Worn ? "worn" : "") @(focused == Optional.Some(instance) ? "focused" : "") @LoadoutShaping.ToMasterworkClass(option.Marks)"
                                data-tier="@LoadoutShaping.ToTierText(option.Marks)" data-masterwork="@LoadoutShaping.ToMasterworkText(option.Marks)"
                                title="@LoadoutShaping.AddMarks($"{option.Tile.Name} — {option.TypeLine}", option.Marks)" aria-label="@option.Tile.Name" data-instance="@instance.Value"
                                @onpointerenter="e => Hover(instance, e)" @onclick="() => ChooseAsync(instance)">
                            @if (option.Tile.Icon is Optional<string>.Some icon)
                            {
                                <img src="@icon.Value" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="icon-initials">@(option.Tile.Name.Length > 0 ? option.Tile.Name[..1] : "?")</span>
                            }
                            <TileOverlays Marks="option.Marks" />
                            @if (option.Worn)
                            {
                                <span class="armor-worn-mark" aria-hidden="true">✓</span>
                            }
                        </button>
                        <span class="tile-badge @LoadoutShaping.ToMasterworkClass(option.Marks)" aria-hidden="true">
                            @if (option.Marks.Breaker is Optional<BreakerBadge>.Some breaker)
                            {
                                <img class="breaker-icon" src="@breaker.Value.Icon" alt="" loading="lazy" />
                            }
                            @if (option.DamageIcon is Optional<string>.Some damage)
                            {
                                <img class="damage-icon" src="@damage.Value" alt="" loading="lazy" />
                            }
                        </span>
                    </div>
                }
            </div>
            @if (shown is Optional<WeaponOptionView>.Some details)
            {
                var weapon = details.Value;
                <div class="armor-option-details" data-testid="weapon-option-details">
                    <div class="armor-option-name">@weapon.Tile.Name@(weapon.TypeLine.Length > 0 ? $" · {weapon.TypeLine}" : "")</div>
                    @if (LoadoutShaping.AddMarks("", weapon.Marks) is { Length: > 0 } marked)
                    {
                        <div class="armor-option-marks" data-testid="weapon-option-marks">@marked</div>
                    }
                    @if (!weapon.Perks.IsEmpty)
                    {
                        <div class="weapon-option-perks" data-testid="weapon-option-perks">
                            @foreach (var perk in weapon.Perks)
                            {
                                <span class="weapon-option-perk @(perk.InRules ? "in-rules" : "")" title="@perk.Name">
                                    <span class="icon-tile perk @(perk.InRules ? "" : "out")">
                                        @if (perk.Icon is Optional<string>.Some perkIcon)
                                        {
                                            <img src="@perkIcon.Value" alt="" loading="lazy" />
                                        }
                                    </span>
                                    <span class="weapon-option-perk-name">@perk.Name</span>
                                </span>
                            }
                        </div>
                    }
                    @if (weapon.Catalyst)
                    {
                        <div class="muted">Its catalyst is in: the build turns it on.</div>
                    }
                    <div class="muted">@weapon.Place@(weapon.Worn ? " · the build wears this one" : "")</div>
                    @if (!weapon.Worn)
                    {
                        <button type="button" class="btn primary small" data-action="wear-weapon" @onclick="() => PickAsync(weapon.Instance)">Use this weapon</button>
                    }
                </div>
            }
            else
            {
                <p class="muted armor-picker-hint">Tap a weapon to see its perks; tap it again to use it.</p>
            }
        }
        @foreach (var note in view.Notes)
        {
            <p class="muted armor-picker-note">@note</p>
        }
    </div>
</Modal>

@code {
    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    [Parameter, EditorRequired]
    public BungieProfile Profile { get; set; } = null!;

    /// <summary>Where a pick goes: in place of one of the build's weapons, or into an empty slot.</summary>
    [Parameter, EditorRequired]
    public WeaponTarget Target { get; set; } = null!;

    /// <summary>A weapon picked: the designer swaps it into the build.</summary>
    [Parameter]
    public EventCallback<WeaponPick> OnPick { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Optional<ItemInstanceId> focused = Optional.None<ItemInstanceId>();

    /// <summary>The copy the build's weapon in this slot wears, when the player owns it: the picker opens showing it.</summary>
    private Optional<ItemInstanceId> worn = Optional.None<ItemInstanceId>();

    protected override void OnInitialized()
    {
        var options = LoopDesigning.ListWeaponOptions(Build, Profile, Target);                   // pure
        var wearing = options.Options.Where(option => option.Worn).Select(option => Optional.Some(option.Weapon.InstanceId)).FindFirstSome(); // pure
        worn = wearing;                                                                          // impure (component state)
        focused = wearing;                                                                       // impure (component state)
    }

    /// <summary>A mouse over a weapon shows its perks (a touch doesn't hover: its first tap does).</summary>
    private void Hover(ItemInstanceId instance, PointerEventArgs e)
    {
        if (e.PointerType == "mouse")
        {
            focused = Optional.Some(instance);                                                  // impure (component state)
        }
    }

    /// <summary>A click on the weapon showing uses it (the one the build wears closes the picker); on another weapon, shows that one.</summary>
    private async Task ChooseAsync(ItemInstanceId instance)
    {
        if (focused == Optional.Some(instance) && worn == Optional.Some(instance))
        {
            await OnClose.InvokeAsync();                                                         // impure
            return;
        }

        if (focused == Optional.Some(instance))
        {
            await PickAsync(instance);                                                           // impure
            return;
        }

        focused = Optional.Some(instance);                                                       // impure (component state)
    }

    private async Task PickAsync(ItemInstanceId instance) =>
        await OnPick.InvokeAsync(new WeaponPick(Target, instance));                              // impure

    private static string DescribeTier(IconTile tile) =>
        tile.Tier.Match(tier => tier.Value == ItemTier.Exotic ? "exotic" : tier.Value == ItemTier.Legendary ? "legendary" : "", _ => "");
}
