@inject BungieAccount Account
@* The build's stats: as the build has them ("?" where it doesn't say), typed by hand, or from the player's own armor
   after a Bungie login — the share's own pieces when the loadout is theirs, else the pieces they pick with ⋯ in the
   build's armor — added up with the build's stat mods, tuning and fragments the way DIM does (LoopDesigning). After
   the login this section says only that, in one line. Whatever is used goes into the embedded build's stats:. *@
<div class="stats-head">
    <h3 class="section-label">Stats</h3>
    @if (OnSetStats.HasDelegate && !editing)
    {
        <button type="button" class="btn ghost small" data-action="edit-stats" @onclick="StartEditing">Edit</button>
    }
</div>
@if (editing)
{
    <div class="stats-edit" data-testid="stats-edit">
        @for (var i = 0; i < StatsShaping.Stats.Length; i++)
        {
            var index = i;
            var stat = StatsShaping.Stats[index];
            <label class="stat-input">
                <span class="stat-name">@stat.Name</span>
                <input type="number" min="0" max="200" step="1" inputmode="numeric" placeholder="?" data-stat="@stat.Name"
                       value="@inputs[index]" @onchange="e => SetInput(index, e)" />
            </label>
        }
    </div>
    @foreach (var problem in problems)
    {
        <p class="stats-problem" role="alert">@problem</p>
    }
    <div class="stats-actions">
        <button type="button" class="btn primary small" data-action="save-stats" @onclick="SaveAsync">Save</button>
        <button type="button" class="btn ghost small" @onclick="CancelEditing">Cancel</button>
        <span class="muted stats-hint">Empty is "?".</span>
    </div>
}
else
{
    <StatBars Bars="StatsShaping.ToBars(Build.Build.Stats)" TestId="stats" />
}

@if (OnSetStats.HasDelegate && Account.CanLogIn)
{
    @if (Profile.IsSome())
    {
        @* After the login: one line. The build's own armor was loaded (its stats set), or how to pick yours (⋯). *@
        @if (Note is Optional<string>.Some note)
        {
            <p class="stats-armor-note" role="status" data-testid="armor-note">@note.Value</p>
        }
    }
    else
    {
        <div class="stats-login" data-testid="stats-login">
            @if (waiting)
            {
                <p class="muted">Waiting for Bungie's login in its window…</p>
                <button type="button" class="btn ghost small" data-action="cancel-login" @onclick="CancelLoginAsync">Cancel</button>
            }
            else
            {
                <p class="stats-login-note">
                    Log in with Bungie to load this build's stats from your own armor. Loopsmith asks Bungie for read-only access to
                    your characters, inventory and vault, finds this loadout's armor and adds up its stats with its mods and
                    fragments, the way DIM does. It changes nothing in your account and keeps nothing: the access is used once, in
                    this tab, and only with bungie.net.
                </p>
                <button type="button" class="btn primary" data-action="bungie-login" @onclick="LogInAsync">Log in with Bungie</button>
            }
            @if (problem is Optional<string>.Some why)
            {
                <p class="stats-problem" role="alert" data-testid="stats-login-problem">@why.Value</p>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>Stats typed for the build; none: the stats are only shown.</summary>
    [Parameter]
    public EventCallback<StatLine> OnSetStats { get; set; }

    /// <summary>The player's armor and characters after their login (none: not logged in).</summary>
    [Parameter]
    public Optional<BungieProfile> Profile { get; set; } = Optional.None<BungieProfile>();

    /// <summary>What to tell the player after the login: whose the build's armor is, how to pick theirs.</summary>
    [Parameter]
    public Optional<string> Note { get; set; } = Optional.None<string>();

    /// <summary>The login read the player's profile (the designer keeps it and sets the stats when the loadout is theirs).</summary>
    [Parameter]
    public EventCallback<BungieProfile> OnLoggedIn { get; set; }

    private bool editing;
    private ImmutableArray<string> inputs = [];
    private ImmutableArray<string> problems = [];
    private bool waiting;
    private Optional<string> problem = Optional.None<string>();

    private void StartEditing()
    {
        var typed = StatsShaping.ToInputs(Build.Build.Stats);                                    // pure
        inputs = typed;                                                                          // impure (component state)
        problems = [];                                                                           // impure (component state)
        editing = true;                                                                          // impure (component state)
    }

    private void CancelEditing() =>
        editing = false;                                                                         // impure (component state)

    private void SetInput(int index, ChangeEventArgs e) =>
        inputs = inputs.SetItem(index, e.Value?.ToString() ?? "");                               // impure (component state)

    private async Task SaveAsync()
    {
        var read = LoopDesigning.ReadStatInputs(inputs);                                         // pure
        var wrong = read.Match(_ => ImmutableArray<string>.Empty, error => error.Failure);       // pure
        problems = wrong;                                                                        // impure (component state)
        if (read is not Result<StatLine, ImmutableArray<string>>.Ok typed)
        {
            return;
        }

        editing = false;                                                                         // impure (component state)
        await OnSetStats.InvokeAsync(typed.Value);                                               // impure
    }

    private async Task LogInAsync()
    {
        waiting = true;                                                                          // impure (component state)
        problem = Optional.None<string>();                                                       // impure (component state)
        var loaded = await Account.LoadProfileAsync();                                           // impure (window, network)
        var refused = loaded.Match(_ => Optional.None<string>(), error => Optional.Some(error.Failure)); // pure
        waiting = false;                                                                         // impure (component state)
        problem = refused;                                                                       // impure (component state)
        if (loaded is Result<BungieProfile, string>.Ok read)
        {
            await OnLoggedIn.InvokeAsync(read.Value);                                            // impure
        }
    }

    private async Task CancelLoginAsync() =>
        await Account.CancelAsync();                                                             // impure
}
