@* A build laid out the way DIM shows a loadout: the subclass with its super, abilities, aspects and fragments; the
   artifact perks; the weapons (an exotic's catalyst after its perks); each armor piece with the mods of its slot; the
   general mods; the armor sets with their 2- and 4-piece perks. Icons are Bungie's (from the manifest excerpt); a square
   without one shows its initials. What the rules don't know carries a small ⊘ in its lower-right corner. Tapping a square opens its details (Bungie's
   text and Loopsmith's rules); legendary armor and weapons open none, their perks and mods do. After the player's Bungie
   login, the player's copies of its pieces and weapons (the share's when theirs, else their own) show their marks as
   DIM does: the tier's diamonds, a masterwork's glow and gold border. A weapon shows its breaker and element under its
   square. *@
@{
    var view = LoadoutShaping.ShapeLoadout(Build, Profile);
}
<div class="loadout @(Compact ? "compact" : "")" data-testid="loadout">
    <div class="loadout-row">
        <section class="loadout-box subclass-box" aria-label="Subclass">
            <h4 class="loadout-label">Subclass</h4>
            <div class="subclass-body">
                <div class="subclass-emblem">
                    @if (view.Subclass.Subclass is Optional<IconTile>.Some subclassItem)
                    {
                        @RenderTile(subclassItem.Value, "subclass-icon")
                    }
                    @RenderTile(view.Subclass.Super, "super-icon")
                </div>
                <div class="icon-grid">
                    @foreach (var tile in view.Subclass.Abilities)
                    {
                        @RenderTile(tile, "")
                    }
                    @foreach (var tile in view.Subclass.Aspects)
                    {
                        @RenderTile(tile, "aspect")
                    }
                    @foreach (var tile in view.Subclass.Fragments)
                    {
                        @RenderTile(tile, "fragment")
                    }
                </div>
            </div>
        </section>
        @if (view.Artifact.Item.IsSome() || !view.Artifact.Perks.IsEmpty)
        {
            <section class="loadout-box artifact-box" aria-label="Artifact" data-testid="artifact">
                <h4 class="loadout-label">Artifact</h4>
                @if (view.Artifact.Item is Optional<IconTile>.Some artifact)
                {
                    <div class="artifact-item" data-testid="artifact-item">
                        @RenderTile(artifact.Value, "item artifact")
                        <span class="artifact-name">@artifact.Value.Name</span>
                    </div>
                }
                <div class="icon-grid">
                    @foreach (var tile in view.Artifact.Perks)
                    {
                        @RenderTile(tile, "artifact-perk")
                    }
                </div>
            </section>
        }
    </div>

    @if (!view.Weapons.IsEmpty || CanPickWeapons)
    {
        <section class="loadout-box" aria-label="Weapons">
            <h4 class="loadout-label">Weapons</h4>
            <ol class="weapon-list">
                @foreach (var row in LoadoutShaping.ListWeaponRows(view, CanPickWeapons))
                {
                    @if (row is WeaponRow.Empty empty)
                    {
                        var rowSlot = empty.Slot;
                        <li class="weapon-line empty" data-slot="@rowSlot">
                            <div class="weapon-icon"><span class="icon-tile empty" title="@rowSlot.DescribeWeaponSlot(): no weapon">@rowSlot.DescribeWeaponSlot()</span></div>
                            <div class="weapon-text"><span class="weapon-line-sub">No @rowSlot.DescribeWeaponSlot().ToLowerInvariant() weapon in the build</span></div>
                            @RenderWeaponPick(new WeaponTarget.IntoEmpty(rowSlot), rowSlot)
                        </li>
                    }
                    else if (row is WeaponRow.Worn worn)
                    {
                    var weapon = worn.Weapon;
                    <li class="weapon-line" data-slot="@weapon.Slot" title="@DescribeWeapon(weapon)">
                        <div class="weapon-icon">
                            @RenderMarkedTile(weapon.Weapon, "item", weapon.Marks)
                            <TileFooter Marks="weapon.Marks" DamageIcon="weapon.DamageIcon" DamageName="@weapon.Type.ToString()" TestId="weapon-badge" />
                        </div>
                        <div class="weapon-text">
                            @if (weapon.Page is Optional<string>.Some weaponPage)
                            {
                                <a class="weapon-line-name" href="@weaponPage.Value" target="_blank" rel="noopener noreferrer" title="@weapon.Weapon.Name on light.gg">@weapon.Weapon.Name</a>
                            }
                            else
                            {
                                <span class="weapon-line-name">@weapon.Weapon.Name</span>
                            }
                            <span class="weapon-line-sub">@weapon.Slot.DescribeWeaponSlot()@(weapon.Archetype is Optional<string>.Some archetype ? $" · {DomainPhrasing.DescribeArchetype(archetype.Value)}" : "")</span>
                        </div>
                        <div class="weapon-perks" aria-label="Perks">
                            @foreach (var square in weapon.Perks)
                            {
                                @if (CanPick && square is PerkSquare.Pickable pickable)
                                {
                                    <button type="button" class="perk-slot @(IsOpen(weapon.Index, pickable.Column) ? "open" : "")" data-column="@pickable.Column"
                                            aria-expanded="@(IsOpen(weapon.Index, pickable.Column) ? "true" : "false")"
                                            title="@DescribePickTitle(weapon, pickable)" @onclick="() => TogglePicker(weapon.Index, pickable.Column)">
                                        @RenderPerk(square, false)
                                    </button>
                                }
                                else
                                {
                                    @RenderPerk(square, true)
                                }
                            }
                            @if (weapon.Catalyst is Optional<CatalystSquare>.Some catalyst)
                            {
                                <span class="catalyst-slot @(catalyst.Value.On ? "on" : "off")" data-testid="catalyst" data-on="@(catalyst.Value.On ? "true" : "false")">
                                    @RenderTile(catalyst.Value.Tile with { Name = $"{catalyst.Value.Tile.Name} ({(catalyst.Value.On ? "on" : "off")})" }, "perk catalyst")
                                </span>
                            }
                        </div>
                        @RenderWeaponPick(new WeaponTarget.InPlaceOf(weapon.Index), weapon.Slot)
                    </li>
                    @if (FindOpenColumn(weapon) is Optional<PerkSquare.Pickable>.Some open)
                    {
                        <li class="perk-picker-row">
                            <div class="perk-picker" role="dialog" tabindex="-1" data-testid="perk-picker" data-weapon="@weapon.Index" data-column="@open.Value.Column"
                                 aria-label="@($"Pick {weapon.Weapon.Name}'s perk, column {open.Value.Column + 1}")" @ref="pickerElement" @onkeydown="ClosePickerOnEscape">
                                <div class="perk-picker-head">
                                    <span class="perk-picker-title">@weapon.Weapon.Name · column @(open.Value.Column + 1)</span>
                                    <button type="button" class="btn ghost icon" title="Close" aria-label="Close" data-action="perk-picker-close" @onclick="ClosePicker">✕</button>
                                </div>
                                <div class="perk-options">
                                    @foreach (var option in open.Value.Options)
                                    {
                                        var picked = open.Value.Perk.Map(perk => perk.Hash) == Optional.Some(option.Hash);
                                        <button type="button" class="perk-option @(picked ? "picked" : "") @(option.Tile.InRules ? "in-rules" : "")"
                                                data-hash="@option.Hash.Value" aria-pressed="@(picked ? "true" : "false")"
                                                title="@DescribeTooltip(option.Tile)" @onclick="() => PickPerkAsync(weapon.Index, open.Value.Column, Optional.Some(option.Hash))">
                                            @RenderTile(option.Tile, "perk", false)
                                            <span class="perk-option-text">
                                                <span class="perk-option-name">@option.Tile.Name</span>
                                                <span class="perk-option-type">@DescribeOption(option)</span>
                                            </span>
                                        </button>
                                    }
                                </div>
                                <div class="perk-picker-foot">
                                    <span class="muted">@PickerNote</span>
                                    @if (open.Value.Perk is Optional<PickedPerk>.Some held && held.Value.Tile.Details is Optional<ItemDetails>.Some heldDetails)
                                    {
                                        <button type="button" class="btn ghost" data-action="perk-details" @onclick="() => OpenDetails(heldDetails.Value)">About @held.Value.Tile.Name</button>
                                    }
                                    @if (open.Value.Perk.IsSome())
                                    {
                                        <button type="button" class="btn" data-action="perk-clear" @onclick="() => PickPerkAsync(weapon.Index, open.Value.Column, Optional.None<ItemHash>())">Clear (?)</button>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                    }
                }
            </ol>
        </section>
    }

    @if (!view.Armor.IsEmpty || !view.GeneralMods.IsEmpty)
    {
        <section class="loadout-box" aria-label="Armor">
            <h4 class="loadout-label">Armor</h4>
            <div class="armor-row">
                @foreach (var piece in LoadoutShaping.ListArmorRows(view, CanPickArmor))
                {
                    var slot = piece.Slot;
                    <div class="armor-piece" data-slot="@slot">
                        @if (piece.Piece is Optional<IconTile>.Some item)
                        {
                            <div class="armor-icon">
                                @RenderMarkedTile(item.Value, "item", piece.Marks)
                                <TileFooter Marks="piece.Marks" TestId="armor-badge" />
                            </div>
                        }
                        else
                        {
                            <span class="icon-tile empty" title="@slot.DescribeArmorSlot(): no piece named">@slot.DescribeArmorSlot()</span>
                        }
                        @if (CanPickArmor)
                        {
                            <button type="button" class="btn ghost small armor-pick" data-action="pick-armor" data-slot="@slot"
                                    title="Pick your own @slot.DescribeArmorSlot().ToLowerInvariant()" aria-label="Pick your own @slot.DescribeArmorSlot().ToLowerInvariant()"
                                    aria-haspopup="dialog" @onclick="() => OpenArmorPicker(slot)">⋯</button>
                        }
                        <div class="icon-grid mods">
                            @foreach (var mod in piece.Mods)
                            {
                                @RenderTile(mod, "mod")
                            }
                        </div>
                    </div>
                }
            </div>
            @if (!view.GeneralMods.IsEmpty)
            {
                <div class="general-mods">
                    <span class="loadout-sublabel">General mods</span>
                    <div class="icon-grid">
                        @foreach (var mod in view.GeneralMods)
                        {
                            @RenderTile(mod, "mod")
                        }
                    </div>
                </div>
            }
        </section>
    }

    @if (!view.ArmorSets.IsEmpty || !view.SetBonuses.IsEmpty)
    {
        <div class="set-bonuses" data-testid="armor-sets">
            <span class="loadout-sublabel">Armor set</span>
            @foreach (var set in view.ArmorSets)
            {
                <div class="armor-set" data-set="@set.Name">
                    <span class="armor-set-name">@set.Name@(set.Pieces is Optional<int>.Some pieces ? $" · {pieces.Value} {(pieces.Value == 1 ? "piece" : "pieces")}" : "")</span>
                    <div class="armor-set-perks">
                        @foreach (var perk in set.Perks)
                        {
                            <div class="set-perk @(perk.Active ? "active" : "inactive")" data-pieces="@perk.Pieces">
                                @RenderTile(perk.Tile, "set-perk")
                                <span class="set-perk-text">
                                    <span class="set-perk-name">@perk.Tile.Name</span>
                                    <span class="set-perk-pieces">@perk.Pieces-piece@(perk.Active ? "" : " · not active")</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
            @foreach (var bonus in view.SetBonuses)
            {
                <div class="set-perk active">
                    @RenderTile(bonus, "set-perk")
                    <span class="set-perk-text"><span class="set-perk-name">@bonus.Name</span></span>
                </div>
            }
        </div>
    }

    @if (details is Optional<ItemDetails>.Some shownDetails && ItemInfoShaping.ShapeInfo(Build, shownDetails.Value) is Optional<ItemInfo>.Some info)
    {
        <ItemInfoDialog Info="info.Value" OnClose="CloseDetails" OnSetCatalyst="OnSetCatalyst" />
    }

    @if (armorPicker is Optional<ArmorSlot>.Some pickerSlot && Profile is Optional<BungieProfile>.Some owned)
    {
        <ArmorPicker Build="Build" Profile="owned.Value" Slot="pickerSlot.Value" OnPick="PickArmorAsync" OnClose="CloseArmorPicker" />
    }

    @if (weaponPicker is Optional<WeaponTarget>.Some target && Profile is Optional<BungieProfile>.Some ownedWeapons)
    {
        <WeaponPicker Build="Build" Profile="ownedWeapons.Value" Target="target.Value" OnPick="PickWeaponAsync" OnClose="CloseWeaponPicker" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>The preview card's size: smaller squares.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Set by the designer: a weapon's perk squares then open a picker of what each column rolls with. Unset (the Home card): read-only.</summary>
    [Parameter]
    public EventCallback<PerkPick> OnPickPerk { get; set; }

    /// <summary>Set by the designer: an exotic's catalyst can be turned on or off from its details. Unset (the Home card): read-only.</summary>
    [Parameter]
    public EventCallback<CatalystToggle> OnSetCatalyst { get; set; }

    /// <summary>The player's armor and weapons after their Bungie login: each armor and weapon slot then has ⋯, which picks from them.</summary>
    [Parameter]
    public Optional<BungieProfile> Profile { get; set; } = Optional.None<BungieProfile>();

    /// <summary>Set by the designer: a piece picked from the player's armor is swapped into the build. Unset (the Home card): read-only.</summary>
    [Parameter]
    public EventCallback<ArmorPick> OnPickArmor { get; set; }

    private bool CanPickArmor => Profile.IsSome() && OnPickArmor.HasDelegate;

    /// <summary>Set by the designer: a weapon picked from the player's weapons is swapped into the build (or added). Unset (the Home card): read-only.</summary>
    [Parameter]
    public EventCallback<WeaponPick> OnPickWeapon { get; set; }

    private bool CanPickWeapons => Profile.IsSome() && OnPickWeapon.HasDelegate;

    /// <summary>Where the open weapon picker's pick goes: in place of a weapon, or into an empty slot.</summary>
    private Optional<WeaponTarget> weaponPicker = Optional.None<WeaponTarget>();

    private void OpenWeaponPicker(WeaponTarget target)
    {
        ClosePicker();                                                                           // impure (UI state)
        weaponPicker = Optional.Some(target);                                                    // impure (UI state)
    }

    private void CloseWeaponPicker() =>
        weaponPicker = Optional.None<WeaponTarget>();                                            // impure (UI state)

    private async Task PickWeaponAsync(WeaponPick pick)
    {
        weaponPicker = Optional.None<WeaponTarget>();                                            // impure (UI state)
        await OnPickWeapon.InvokeAsync(pick);                                                    // impure
    }

    /// <summary>⋯ next to a weapon slot (after the login): it opens the weapon picker for that slot.</summary>
    private RenderFragment RenderWeaponPick(WeaponTarget target, WeaponSlot slot) => __builder =>
    {
        @if (CanPickWeapons)
        {
            <button type="button" class="btn ghost small weapon-pick" data-action="pick-weapon" data-slot="@slot"
                    title="Pick your own @slot.DescribeWeaponSlot().ToLowerInvariant() weapon" aria-label="Pick your own @slot.DescribeWeaponSlot().ToLowerInvariant() weapon"
                    aria-haspopup="dialog" @onclick="() => OpenWeaponPicker(target)">⋯</button>
        }
    };

    private Optional<ItemDetails> details = Optional.None<ItemDetails>();

    private Optional<ArmorSlot> armorPicker = Optional.None<ArmorSlot>();

    private void OpenArmorPicker(ArmorSlot slot) =>
        armorPicker = Optional.Some(slot);                                                       // impure (UI state)

    private void CloseArmorPicker() =>
        armorPicker = Optional.None<ArmorSlot>();                                                // impure (UI state)

    private async Task PickArmorAsync(ArmorPick pick)
    {
        armorPicker = Optional.None<ArmorSlot>();                                                // impure (UI state)
        await OnPickArmor.InvokeAsync(pick);                                                     // impure
    }

    private void OpenDetails(ItemDetails open)
    {
        ClosePicker();                                                                           // impure (UI state)
        details = Optional.Some(open);                                                           // impure (UI state)
    }

    private void CloseDetails() =>
        details = Optional.None<ItemDetails>();                                                  // impure (UI state)

    private const string PickerNote = "Green: the rules know it, so it sets things off in the loop; the rest only shows on the weapon.";

    private sealed record OpenPicker(int Weapon, int Column);

    private Optional<OpenPicker> picker = Optional.None<OpenPicker>();
    private bool focusPicker;
    private ElementReference pickerElement;

    private bool CanPick => OnPickPerk.HasDelegate;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPicker && picker.IsSome())
        {
            focusPicker = false;
            await pickerElement.FocusAsync(preventScroll: true);                                 // impure
        }
    }

    private bool IsOpen(int weapon, int column) =>
        picker == Optional.Some(new OpenPicker(weapon, column));

    private Optional<PerkSquare.Pickable> FindOpenColumn(WeaponView weapon) =>
        picker.Bind(open => open.Weapon == weapon.Index
            ? weapon.Perks.OfType<PerkSquare.Pickable>().Where(column => column.Column == open.Column).Select(Optional.Some).FindFirstSome()
            : Optional.None<PerkSquare.Pickable>());

    private void TogglePicker(int weapon, int column)
    {
        picker = IsOpen(weapon, column) ? Optional.None<OpenPicker>() : Optional.Some(new OpenPicker(weapon, column));
        focusPicker = picker.IsSome();
    }

    private void ClosePicker() =>
        picker = Optional.None<OpenPicker>();

    private void ClosePickerOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClosePicker();
        }
    }

    private async Task PickPerkAsync(int weapon, int column, Optional<ItemHash> perk)
    {
        ClosePicker();
        await OnPickPerk.InvokeAsync(new PerkPick(weapon, column, perk));                        // impure
    }

    /// <summary>A perk square; <paramref name="tappable"/> false inside the picker's button (a button can't hold another).</summary>
    private RenderFragment RenderPerk(PerkSquare square, bool tappable) => __builder =>
    {
        @switch (square)
        {
            case PerkSquare.Shown shown:
                @RenderTile(shown.Perk, "perk", tappable)
                break;
            case PerkSquare.Pickable { Perk: Optional<PickedPerk>.Some held }:
                @RenderTile(held.Value.Tile, "perk", tappable)
                break;
            default:
                <span class="icon-tile perk empty-perk" title="@(CanPick ? PickPerk : MissingPerk)" aria-label="Perk not picked">?</span>
                break;
        }
    };

    private static string DescribePickTitle(WeaponView weapon, PerkSquare.Pickable column) =>
        $"{weapon.Weapon.Name}, column {column.Column + 1}: {column.Perk.Match(perk => perk.Value.Tile.Name, _ => DomainPhrasing.Unknown)} — pick a perk";

    private static string DescribeOption(PerkOption option) =>
        string.Join(" · ", new[] { option.Type.UnwrapOr(""), option.Tile.InRules ? "in the rules" : "" }.Where(part => part.Length > 0));

    /// <summary>A square: a button that opens its details when it has some (and <paramref name="tappable"/>), else a plain square.</summary>
    private RenderFragment RenderTile(IconTile tile, string kind, bool tappable = true) =>
        RenderMarkedTile(tile, kind, LoadoutShaping.NoMarks, tappable);

    /// <summary>A copy's square, with its marks drawn on it (TileMarks: the tier's diamonds, a masterwork's glow and border).</summary>
    private RenderFragment RenderMarkedTile(IconTile tile, string kind, TileMarks marks, bool tappable = true) => __builder =>
    {
        @if (tappable && tile.Details is Optional<ItemDetails>.Some tileDetails)
        {
            <button type="button" class="icon-tile tappable @kind @ToneStyling.ToAffinityClass(tile.Affinity) @DescribeTier(tile) @(tile.InRules ? "" : "out") @(tile.Enhanced ? "enhanced" : "") @LoadoutShaping.ToMasterworkClass(marks)"
                    data-tier="@LoadoutShaping.ToTierText(marks)" data-masterwork="@LoadoutShaping.ToMasterworkText(marks)"
                    title="@LoadoutShaping.AddMarks(DescribeTooltip(tile), marks)" aria-label="@tile.Name" aria-haspopup="dialog" @onclick="() => OpenDetails(tileDetails.Value)">
                @RenderTileFace(tile)
                <TileOverlays Marks="marks" />
                @if (!tile.InRules)
                {
                    <UnsupportedMark />
                }
            </button>
        }
        else
        {
            <span class="icon-tile @kind @ToneStyling.ToAffinityClass(tile.Affinity) @DescribeTier(tile) @(tile.InRules ? "" : "out") @(tile.Enhanced ? "enhanced" : "") @LoadoutShaping.ToMasterworkClass(marks)"
                  data-tier="@LoadoutShaping.ToTierText(marks)" data-masterwork="@LoadoutShaping.ToMasterworkText(marks)"
                  title="@LoadoutShaping.AddMarks(DescribeTooltip(tile), marks)" aria-label="@tile.Name">
                @RenderTileFace(tile)
                <TileOverlays Marks="marks" />
                @if (!tile.InRules)
                {
                    <UnsupportedMark />
                }
            </span>
        }
    };

    private RenderFragment RenderTileFace(IconTile tile) => __builder =>
    {
        @if (tile.Icon is Optional<string>.Some icon)
        {
            <img src="@icon.Value" alt="" loading="lazy" />
        }
        else
        {
            <span class="icon-initials">@ToInitials(tile.Name)</span>
        }
        @if (tile.Copies > 1)
        {
            <span class="icon-count">×@tile.Copies</span>
        }
    };

    private static string DescribeTier(IconTile tile) =>
        tile.Tier.Match(tier => tier.Value == ItemTier.Exotic ? "exotic" : tier.Value == ItemTier.Legendary ? "legendary" : "", _ => "");

    private static string DescribeTooltip(IconTile tile) =>
        (tile.Copies > 1 ? $"{tile.Name} ×{tile.Copies}" : tile.Name)
        + tile.Description.Match(description => $" — {description.Value}", _ => "");

    private static string DescribeWeapon(WeaponView weapon) =>
        LoadoutShaping.AddMarks(
            $"{weapon.Weapon.Name} — {weapon.Slot.DescribeWeaponSlot()} · {weapon.Type}{weapon.Archetype.Match(archetype => $" · {DomainPhrasing.DescribeArchetype(archetype.Value)}", _ => "")}",
            weapon.Marks);

    private const string MissingPerk = "Perk not picked: a DIM link carries the weapon, not its roll. Pick it in the designer.";

    private const string PickPerk = "Perk not picked: pick what this column rolled with.";

    /// <summary>"SoR" for Spark of Resistance: what a square without an icon shows.</summary>
    private static string ToInitials(string name) =>
        name == DomainPhrasing.Unknown
            ? name
            : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(3).Select(word => char.ToUpperInvariant(word[0])));
}
