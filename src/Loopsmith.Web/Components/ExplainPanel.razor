@* "What this build does": every trigger and what it sets off, without simulating (BuildExplaining — the CLI's explain). *@
<details class="panel explain-panel">
    <summary>
        <span class="explain-title">What this build does</span>
        <span class="muted">every trigger → outcome [source]</span>
    </summary>
    <div class="explain-tools">
        <label class="toggle"><input type="radio" name="explain-style" checked="@(style == ExplanationStyle.Note)" @onchange="() => SwitchStyle(ExplanationStyle.Note)" /> Note</label>
        <label class="toggle"><input type="radio" name="explain-style" checked="@(style == ExplanationStyle.Tree)" @onchange="() => SwitchStyle(ExplanationStyle.Tree)" /> Tree</label>
    </div>
    <StyledLines Lines="@RenderLines()" Preformatted="@(style == ExplanationStyle.Tree)" />
</details>

@code {
    private readonly Dictionary<ExplanationStyle, ImmutableArray<StyledLine>> rendered = [];
    private object explained = new();
    private ExplanationStyle style = ExplanationStyle.Note;

    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(explained, Build))
        {
            rendered.Clear();
            explained = Build;
        }
    }

    /// <summary>The explanation in the chosen style, computed once per build and style.</summary>
    private ImmutableArray<StyledLine> RenderLines()
    {
        if (!rendered.TryGetValue(style, out var lines))
        {
            var groups = BuildExplaining.ExplainBuild(Build);
            lines = BuildExplaining.RenderExplanation(groups, style);
            rendered[style] = lines;
        }

        return lines;
    }

    private void SwitchStyle(ExplanationStyle next) =>
        style = next;
}
