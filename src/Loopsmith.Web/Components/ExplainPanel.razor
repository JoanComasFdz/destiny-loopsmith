@* "What this build does": every trigger and what it sets off, as a tree, without simulating (LoopDesigning.ExplainBuild). *@
<details class="panel explain-panel" data-testid="build-explanation">
    <summary data-action="build-explanation-toggle">
        <span class="explain-title">What this build does</span>
        <span class="muted">every trigger → outcome [source]</span>
    </summary>
    <StyledLines Lines="@RenderLines()" Preformatted="true" />
</details>

@code {
    private ImmutableArray<StyledLine> rendered = [];
    private object explained = new();

    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>The explanation, computed once per build.</summary>
    private ImmutableArray<StyledLine> RenderLines()
    {
        if (!ReferenceEquals(explained, Build))
        {
            rendered = LoopDesigning.ExplainBuild(Build);
            explained = Build;
        }

        return rendered;
    }
}
