@* A step's outcomes, one line each (LoopDesigning.ShapeStepOutcomes, the CLI's wording): the event, then where what
   it set off comes from (OutcomeOrigins: "Fragment · Arcstrider", "Weapon perk · Festival Flight", with that item's
   icon), each element from there (its icon and name) and each of its outcomes under it, as a bulleted list; a cascade
   (↳ Bolt Charge gained) nests under the event that set it off, and a pickup picked up shows a 📍 (it is on the floor).
   An element's or keyword's name shows a preview on hover (or focus) and its details on a tap. *@
<div class="outcomes">
    @if (Outcomes.Events.IsEmpty && Outcomes.Notes.IsEmpty)
    {
        <div class="outcome-none tone-muted">nothing triggers</div>
    }
    @for (var e = 0; e < Outcomes.Events.Length; e++)
    {
        var shaped = Outcomes.Events[e];
        var eventKey = $"e{e}";
        <div class="outcome-event" style="--depth:@shaped.Depth" data-depth="@shaped.Depth">
            <div class="outcome-event-head">
                @if (shaped.Pickup.IsSome())
                {
                    <span class="outcome-pickup-mark" aria-hidden="true">📍 </span>
                }
                else if (shaped.Depth > 0)
                {
                    <span class="tone-muted">↳ </span>
                }
                @if (shaped.Weapon.Bind(slot => LoopDesigning.FindWeaponIcon(Build, slot)) is Optional<string>.Some weaponIcon)
                {
                    <img class="inline-icon event-weapon-icon" src="@LoadoutShaping.ToIconUrl(weaponIcon.Value)" alt="" loading="lazy" data-testid="event-weapon-icon" />
                }
                @RenderParts(shaped.Parts, "tone-strong outcome-event-name", eventKey)
                @if (shaped.Repeats > 1)
                {
                    <span class="tone-strong"> ×@shaped.Repeats</span>
                }
            </div>
            @{ var groups = OutcomeOrigins.GroupByOrigin(Build, shaped); }
            @for (var g = 0; g < groups.Length; g++)
            {
                var group = groups[g];
                <div class="outcome-origin" data-origin="@group.Origin.Label">
                    <div class="outcome-origin-head">
                        @if (group.Origin.Icon is Optional<string>.Some originIcon)
                        {
                            <img class="outcome-origin-icon" src="@originIcon.Value" alt="" loading="lazy" />
                        }
                        <span>@group.Origin.Label</span>
                    </div>
                    @for (var s = 0; s < group.Sources.Length; s++)
                    {
                        var source = group.Sources[s];
                        var sourceKey = $"{eventKey}g{g}s{s}";
                        <div class="outcome-source" data-source="@source.Source.Value">
                            @RenderElement(source, sourceKey)
                            @if (!source.Outcomes.IsEmpty)
                            {
                                <ul class="outcome-lines">
                                    @for (var l = 0; l < source.Outcomes.Length; l++)
                                    {
                                        var line = source.Outcomes[l];
                                        <li class="outcome-line">
                                            @RenderParts(line.Parts, ToneStyling.ToToneClass(line.Tone), $"{sourceKey}l{l}")
                                            @if (line.Chance)
                                            {
                                                <span class="tone-muted"> (chance)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @foreach (var reason in source.Reasons)
                            {
                                <div class="outcome-detail tone-muted">why: @reason</div>
                            }
                            @foreach (var caveat in source.Caveats)
                            {
                                <div class="outcome-detail tone-muted">· @caveat</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
    @foreach (var note in Outcomes.Notes)
    {
        <div class="outcome-note tone-warning">! @note</div>
    }
</div>

@code {
    /// <summary>The pickup Bungie's data has no icon for (its keyword tooltips, DestinyTraitDefinition, don't name it).</summary>
    private static readonly PickupId OrbOfPower = PickupId.From("orb-of-power");

    [Parameter, EditorRequired]
    public StepOutcomes Outcomes { get; set; } = null!;

    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>A name tapped: the element whose details to show.</summary>
    [Parameter]
    public EventCallback<ItemDetails> OnShowDetails { get; set; }

    // The name under the pointer (or focused), by its place in the step: its preview shows next to it.
    private Optional<string> hovered = Optional.None<string>();
    private Optional<StepOutcomes> shownOutcomes = Optional.None<StepOutcomes>();

    /// <summary>
    /// An element that fired: its icon and name, in its affinity's colour. One with no icon in Bungie's data shows a dot
    /// in its affinity — but the Orb of Power, which Bungie gives no icon, a ⚪ (an orb).
    /// </summary>
    private RenderFragment RenderElement(SourceOutcomes source, string key) => __builder =>
    {
        var icon = LoadoutShaping.FindElementIcon(Build.Catalog, source.Source);
        <span class="outcome-name-wrap">
            <button type="button" class="outcome-element @ToneStyling.ToToneClass(source.Affinity.ToTone()) @ToneStyling.ToAffinityClass(source.Affinity)"
                    data-element="@source.Source.Value" title="@LoopDesigning.DescribeElementType(Build, source.Source)"
                    @onclick="() => ShowDetailsAsync(source.Source)" @onclick:stopPropagation="true"
                    @onmouseenter="() => Hover(key)" @onmouseleave="() => Unhover(key)" @onfocus="() => Hover(key)" @onblur="() => Unhover(key)">
                @if (icon is Optional<string>.Some known)
                {
                    <img class="outcome-icon" src="@known.Value" alt="" loading="lazy" />
                }
                else if (LoopDesigning.FindKeyword(Build, source.Source) == Optional.Some<KeywordRef>(new KeywordRef.Pickup(OrbOfPower)))
                {
                    <span class="outcome-icon glyph" aria-hidden="true">⚪</span>
                }
                else
                {
                    <span class="outcome-icon placeholder" aria-hidden="true"></span>
                }
                <span>@source.Name</span>
            </button>
            @RenderPreview(source.Source, key)
        </span>
    };

    /// <summary>
    /// A text in its parts: each keyword it names (Bolt Charge, Jolted, Ionic Trace) always in its affinity's colour, and
    /// tappable for its details when the catalog has it as an element; the rest in the line's tone.
    /// </summary>
    private RenderFragment RenderParts(ImmutableArray<TextPart> parts, string toneClass, string key) => __builder =>
    {
        for (var p = 0; p < parts.Length; p++)
        {
            var part = parts[p];
            var partKey = $"{key}p{p}";
            @RenderPart(part, toneClass, partKey)
        }
    };

    private RenderFragment RenderPart(TextPart part, string toneClass, string key) => __builder =>
    {
        if (part.Keyword is Optional<KeywordPart>.Some keyword && keyword.Value.Element is Optional<ElementId>.Some element)
        {
            <span class="outcome-name-wrap">
                <button type="button" class="outcome-keyword keyword @ToneStyling.ToAffinityClass(keyword.Value.Affinity)" data-keyword="@element.Value.Value"
                        @onclick="() => ShowDetailsAsync(element.Value)" @onclick:stopPropagation="true"
                        @onmouseenter="() => Hover(key)" @onmouseleave="() => Unhover(key)" @onfocus="() => Hover(key)" @onblur="() => Unhover(key)">@RenderKeywordIcon(keyword.Value)@part.Text</button>
                @RenderPreview(element.Value, key)
            </span>
        }
        else if (part.Keyword is Optional<KeywordPart>.Some named)
        {
            <span class="keyword @ToneStyling.ToAffinityClass(named.Value.Affinity)">@RenderKeywordIcon(named.Value)@part.Text</span>
        }
        else
        {
            <span class="@toneClass">@part.Text</span>
        }
    };

    /// <summary>A keyword's icon in front of its name (the game's own, Jolted, Woven Mail), when the excerpt has it.</summary>
    private static RenderFragment RenderKeywordIcon(KeywordPart keyword) => __builder =>
    {
        if (keyword.Icon is Optional<string>.Some icon)
        {
            <img class="inline-icon keyword-icon" src="@LoadoutShaping.ToIconUrl(icon.Value)" alt="" loading="lazy" />
        }
    };

    private RenderFragment RenderPreview(ElementId element, string key) => __builder =>
    {
        if (hovered.Match(some => some.Value == key, _ => false)
            && ItemInfoShaping.ShapePreview(Build, new ItemDetails.OfElement(element)) is Optional<ItemPreview>.Some preview)
        {
            <span class="item-preview @ToneStyling.ToAffinityClass(preview.Value.Affinity)" role="tooltip" data-testid="item-preview">
                <span class="item-preview-head">
                    @if (preview.Value.Icon is Optional<string>.Some icon)
                    {
                        <img class="item-preview-icon" src="@icon.Value" alt="" />
                    }
                    <span>
                        <span class="item-preview-name">@preview.Value.Name</span>
                        <span class="item-preview-type">@preview.Value.TypeLine</span>
                    </span>
                </span>
                @if (preview.Value.Text is Optional<string>.Some text)
                {
                    <span class="item-preview-text">@text.Value</span>
                }
                <span class="item-preview-hint">Tap for details</span>
            </span>
        }
    };

    private void Hover(string key) =>
        hovered = Optional.Some(key);

    /// <summary>Only the name left hides its preview (a focused name keeps its own while the mouse passes another).</summary>
    private void Unhover(string key) =>
        hovered = hovered.Match(some => some.Value == key, _ => false) ? Optional.None<string>() : hovered;

    /// <summary>A card shows another step after a move or a removal: no preview carried over to a name at the same place.</summary>
    protected override void OnParametersSet()
    {
        if (!shownOutcomes.Match(shown => ReferenceEquals(shown.Value, Outcomes), _ => false))
        {
            shownOutcomes = Optional.Some(Outcomes);
            hovered = Optional.None<string>();
        }
    }

    private async Task ShowDetailsAsync(ElementId element)
    {
        hovered = Optional.None<string>();
        await OnShowDetails.InvokeAsync(new ItemDetails.OfElement(element));                     // impure
    }
}
