@* A dialog over the page. Closing is the host's decision (OnClose). *@
<div class="modal-backdrop" @onclick="CloseModal">
    <section class="modal @Size" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
        <header class="modal-head">
            @if (TitleUrl is Optional<string>.Some url)
            {
                <h2><a href="@url.Value" target="_blank" rel="noopener noreferrer" title="Open on light.gg">@Title <span aria-hidden="true">↗</span></a></h2>
            }
            else
            {
                <h2>@Title</h2>
            }
            <button class="btn ghost icon" title="Close" aria-label="Close" @onclick="CloseModal">✕</button>
        </header>
        <div class="modal-body">@ChildContent</div>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string Size { get; set; } = "";

    /// <summary>A page the title links to (an item's light.gg page).</summary>
    [Parameter]
    public Optional<string> TitleUrl { get; set; } = Optional.None<string>();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Task CloseModal() =>
        OnClose.InvokeAsync();
}
