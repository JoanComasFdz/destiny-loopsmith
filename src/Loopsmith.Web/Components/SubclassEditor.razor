@* The subclass editor, laid out like the game's subclass screen: the subclass's icon, name and "Hunter Subclass" as its
   header; the super on the left; Abilities (class ability, jump, melee, grenade) and Aspects in one row beside it,
   Fragments under them (at phone width the super sits above them and a group that doesn't fit its row wraps). Each
   group is a grey panel of squares (tap one for its details), each with a footer holding ⋯, which opens a dropdown
   under the slot (above it when there's no room below) with everything the subclass can hold there (Bungie's manifest;
   the ones the rules don't know carry ⊘, a jump the rules don't have none: movement has no part in a loop). The
   dropdown floats over the slots after it, so none of them moves; ⋯ again, a tap outside it or Escape closes it (Escape
   doesn't close the editor while a dropdown is open). A fragment's ✕ empties its slot; an aspect has none, it is only
   swapped for another. The aspects open the fragment slots; an aspect change that closes slots takes the last fragments
   out and names them. Save hands the plugs to the designer (LoopDesigning.EditSubclass); Cancel, ✕ or Escape throws the
   changes away. *@
@using System.Globalization
@inject BrowserInterop Browser
@{
    var slots = LoopDesigning.CountFragmentSlots(Build, draft.Aspects).Slots;
    var fragmentCapacity = slots.Match(count => count.Value, _ => fragmentSlots.Count(slot => slot.IsSome()) + 1);
    var slotText = slots.Match(count => count.Value.ToString(CultureInfo.InvariantCulture), _ => DomainPhrasing.Unknown);
}
<Modal Title="@($"{heading.Name}, {heading.Kind}")" Size="snug" OnClose="OnClose">
    <Heading>
        <div class="sub-head" data-testid="subclass-head">
            @if (heading.Icon is Optional<IconTile>.Some subclassItem)
            {
                @RenderTile(subclassItem.Value, "sub-head-icon", true)
            }
            <div class="sub-head-text">
                <h2 class="sub-head-name" data-testid="subclass-name">@heading.Name</h2>
                <span class="sub-head-kind" data-testid="subclass-kind">@heading.Kind</span>
            </div>
        </div>
    </Heading>
    <ChildContent>
        <div class="subclass-editor" data-testid="subclass-editor" @onclick="ClosePicker" @onkeydown="CloseOnEscape" @onkeydown:stopPropagation="true">
            <div class="sub-layout">
                <div class="sub-super" data-testid="super-slot">
                    @RenderSingle(SubclassSlot.Super, "Super", draft.Super)
                </div>
                <div class="sub-sections">
                    <div class="sub-row">
                        <section class="sub-section" aria-labelledby="sub-abilities">
                            <h3 class="sub-heading" id="sub-abilities">Abilities</h3>
                            <div class="sub-group" data-testid="ability-slots">
                                @RenderSingle(SubclassSlot.ClassAbility, "Class ability", draft.ClassAbility)
                                @RenderSingle(SubclassSlot.Jump, "Jump", draft.Jump)
                                @RenderSingle(SubclassSlot.Melee, "Melee", draft.Melee)
                                @RenderSingle(SubclassSlot.Grenade, "Grenade", draft.Grenade)
                            </div>
                        </section>
                        <section class="sub-section" aria-labelledby="sub-aspects">
                            <h3 class="sub-heading" id="sub-aspects">Aspects</h3>
                            <div class="sub-group" data-testid="aspect-slots">
                                @for (var index = 0; index < AspectSlots; index++)
                                {
                                    @RenderMany(SubclassSlot.Aspect, "Aspect", index, index < draft.Aspects.Length ? Optional.Some(draft.Aspects[index]) : Optional.None<ItemHash>())
                                }
                            </div>
                        </section>
                    </div>
                    <section class="sub-section" aria-labelledby="sub-fragments">
                        <h3 class="sub-heading" id="sub-fragments">Fragments <span class="sub-heading-note" data-testid="fragment-count">· @slotText slot@(slotText == "1" ? "" : "s")</span></h3>
                        @if (!slots.IsSome())
                        {
                            <p class="muted sub-note" data-testid="fragment-unknown">Loopsmith doesn't know how many fragment slots these aspects open, so it doesn't limit the fragments.</p>
                        }
                        @if (trimNote.Length > 0)
                        {
                            <p class="tone-warning sub-note" role="status" data-testid="trim-note">@trimNote</p>
                        }
                        <div class="sub-group" data-testid="fragment-slots">
                            @for (var index = 0; index < Math.Max(fragmentCapacity, fragmentSlots.Length); index++)
                            {
                                @RenderMany(SubclassSlot.Fragment, "Fragment", index, index < fragmentSlots.Length ? fragmentSlots[index] : Optional.None<ItemHash>())
                            }
                        </div>
                    </section>
                </div>
            </div>
            <div class="sub-foot">
                <button type="button" class="btn" data-action="subclass-cancel" @onclick="OnClose">Cancel</button>
                <button type="button" class="btn primary" data-action="subclass-save" @onclick="SaveAsync">Save</button>
            </div>
        </div>
    </ChildContent>
</Modal>

@if (details is Optional<ItemDetails>.Some shown && ItemInfoShaping.ShapeInfo(Build, shown.Value) is Optional<ItemInfo>.Some info)
{
    <ItemInfoDialog Info="info.Value" OnClose="CloseDetails" />
}

@code {
    private const int AspectSlots = 2;

    /// <summary>The id of the open dropdown: it is placed under (or above) its slot once it is shown.</summary>
    private const string OpenListId = "subclass-open-list";

    private sealed record OpenPick(SubclassSlot Slot, int Index);

    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>Save: the plugs the editor holds. The designer replays the loop with them.</summary>
    [Parameter]
    public EventCallback<SubclassPlugs> OnSave { get; set; }

    /// <summary>Cancel, ✕ or Escape: the editor closes and its changes are thrown away.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private SubclassPlugs draft = null!;

    /// <summary>The fragments by slot: ✕ leaves its slot empty, the others stay where they are (the build keeps them as a
    /// list, so Save writes them in slot order and the editor shows them packed next time). The draft's own list isn't read.</summary>
    private ImmutableArray<Optional<ItemHash>> fragmentSlots = [];
    private SubclassHeading heading = null!;
    private Optional<OpenPick> picker = Optional.None<OpenPick>();
    private Optional<ItemDetails> details = Optional.None<ItemDetails>();
    private string trimNote = "";

    protected override void OnInitialized()
    {
        draft = LoopDesigning.ReadSubclassPlugs(Build);                                          // pure
        fragmentSlots = [.. draft.Fragments.Select(Optional.Some)];                              // pure
        heading = LoadoutShaping.DescribeSubclassHeading(Build);                                 // pure
    }

    private RenderFragment RenderSingle(SubclassSlot slot, string label, Optional<ItemHash> plug) =>
        RenderSlot(slot, label, 0, plug, false);

    private RenderFragment RenderMany(SubclassSlot slot, string label, int index, Optional<ItemHash> plug) =>
        RenderSlot(slot, $"{label} {index + 1}", index, plug, true);

    /// <summary>A slot: its plug's square and, in the footer under it, ⋯ and, for a fragment, ✕. <paramref name="many"/>: an
    /// aspect or fragment slot, which can be empty.</summary>
    private RenderFragment RenderSlot(SubclassSlot slot, string label, int index, Optional<ItemHash> plug, bool many) => __builder =>
    {
        var pick = new OpenPick(slot, index);
        var open = picker == Optional.Some(pick);
        <div class="sub-slot @(open ? "open" : "")" data-slot="@slot" data-index="@index">
            @if (plug is Optional<ItemHash>.Some held)
            {
                var tile = LoadoutShaping.DescribeSubclassPlug(Build, held.Value);
                @RenderTile(tile, slot == SubclassSlot.Aspect ? "aspect" : slot == SubclassSlot.Fragment ? "fragment" : "", true)
            }
            else
            {
                <span class="icon-tile empty" title="@label: empty" aria-label="@label: empty">@(many ? "+" : DomainPhrasing.Unknown)</span>
            }
            <div class="sub-slot-foot">
                @if (slot == SubclassSlot.Fragment && plug.IsSome())
                {
                    <button type="button" class="sub-slot-button" data-action="remove-slot" title="Remove @label" aria-label="Remove @label" @onclick="() => RemoveFragment(index)">✕</button>
                }
                <button type="button" class="sub-slot-button sub-slot-pick" id="@DescribePickButtonId(pick)" data-action="change-slot"
                        aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? OpenListId : null)"
                        title="List what @DescribeSlot(slot).ToLowerInvariant() can be" aria-label="List what @label.ToLowerInvariant() can be"
                        @onclick="() => TogglePicker(pick)" @onclick:stopPropagation="true">⋯</button>
            </div>
            @if (open)
            {
                @RenderPicker(pick)
            }
        </div>
    };

    /// <summary>The dropdown of what the slot can hold, one per line, floating under the slot: picking one puts it there and closes the list.</summary>
    private RenderFragment RenderPicker(OpenPick open) => __builder =>
    {
        var options = LoopDesigning.ListSubclassOptions(Build, open.Slot);
        <div class="sub-drop" id="@OpenListId" role="group" tabindex="-1" data-testid="subclass-picker" data-slot="@open.Slot"
             aria-label="@($"Pick {DescribeSlot(open.Slot).ToLowerInvariant()}")" @onclick:stopPropagation="true">
            <div class="sub-drop-options">
                @foreach (var option in options)
                {
                    var hash = option;
                    var tile = LoadoutShaping.DescribeSubclassPlug(Build, hash);
                    var current = FindHeld(open) == Optional.Some(hash);
                    var elsewhere = !current && IsHeldElsewhere(open.Slot, hash);
                    <button type="button" class="perk-option @(current ? "picked" : "")" data-hash="@hash.Value"
                            disabled="@elsewhere" aria-pressed="@(current ? "true" : "false")"
                            title="@(elsewhere ? $"{LoadoutShaping.DescribePlugTooltip(tile)}\n(already equipped)" : LoadoutShaping.DescribePlugTooltip(tile))" @onclick="() => Choose(open, hash)">
                        @RenderTile(tile, "perk", false)
                        <span class="perk-option-text">
                            <span class="perk-option-name">@tile.Name</span>
                            <span class="perk-option-type">@DescribeOption(hash, elsewhere)</span>
                        </span>
                    </button>
                }
            </div>
        </div>
    };

    /// <summary>A plug's square: a button that opens its details (tappable), else a plain square.</summary>
    private RenderFragment RenderTile(IconTile tile, string kind, bool tappable) => __builder =>
    {
        var classes = $"icon-tile {kind} {ToneStyling.ToAffinityClass(tile.Affinity)} {DescribeTier(tile)} {(tile.InRules ? "" : "out")}";
        @if (tappable && tile.Details is Optional<ItemDetails>.Some tileDetails)
        {
            <button type="button" class="@classes tappable" title="@LoadoutShaping.DescribePlugTooltip(tile)" aria-label="@tile.Name" aria-haspopup="dialog" @onclick="() => OpenDetails(tileDetails.Value)">
                @RenderTileFace(tile)
                @if (!tile.InRules)
                {
                    <UnsupportedMark />
                }
            </button>
        }
        else
        {
            <span class="@classes" title="@LoadoutShaping.DescribePlugTooltip(tile)" aria-label="@tile.Name">
                @RenderTileFace(tile)
                @if (!tile.InRules)
                {
                    <UnsupportedMark />
                }
            </span>
        }
    };

    private RenderFragment RenderTileFace(IconTile tile) => __builder =>
    {
        @if (tile.Icon is Optional<string>.Some icon)
        {
            <img src="@icon.Value" alt="" loading="lazy" />
        }
        else
        {
            <span class="icon-initials">@string.Concat(tile.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(3).Select(word => char.ToUpperInvariant(word[0])))</span>
        }
    };

    private static string DescribeTier(IconTile tile) =>
        tile.Tier.Match(tier => tier.Value == ItemTier.Exotic ? "exotic" : tier.Value == ItemTier.Legendary ? "legendary" : "", _ => "");

    private string DescribeOption(ItemHash hash, bool elsewhere)
    {
        var type = LoadoutShaping.FindPlugType(Build, hash).UnwrapOr("");
        return string.Join(" · ", new[] { type, elsewhere ? "equipped" : "" }.Where(part => part.Length > 0));
    }

    private static string DescribeSlot(SubclassSlot slot) =>
        slot switch
        {
            SubclassSlot.ClassAbility => "Class ability",
            _ => slot.ToString(),
        };

    private Optional<ItemHash> FindHeld(OpenPick pick) =>
        pick.Slot switch
        {
            SubclassSlot.Super => draft.Super,
            SubclassSlot.Grenade => draft.Grenade,
            SubclassSlot.Melee => draft.Melee,
            SubclassSlot.ClassAbility => draft.ClassAbility,
            SubclassSlot.Jump => draft.Jump,
            SubclassSlot.Aspect => pick.Index < draft.Aspects.Length ? Optional.Some(draft.Aspects[pick.Index]) : Optional.None<ItemHash>(),
            _ => pick.Index < fragmentSlots.Length ? fragmentSlots[pick.Index] : Optional.None<ItemHash>(),
        };

    /// <summary>True when the plug sits in another slot of the same kind (an aspect or a fragment is equipped once).</summary>
    private bool IsHeldElsewhere(SubclassSlot slot, ItemHash hash) =>
        slot == SubclassSlot.Aspect ? draft.Aspects.Contains(hash) : slot == SubclassSlot.Fragment && fragmentSlots.Contains(Optional.Some(hash));

    /// <summary>The ⋯ of a slot: its id, for the focus to come back to it when its dropdown closes.</summary>
    private static string DescribePickButtonId(OpenPick pick) =>
        $"subclass-pick-{pick.Slot}-{pick.Index}";

    private bool placePicker;
    private Optional<string> refocus = Optional.None<string>();

    /// <summary>A dropdown that just opened is placed under its slot (above it when there's no room below) and takes the
    /// focus, so Escape reaches it; one that closed hands the focus back to its ⋯.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (placePicker && picker.IsSome())
        {
            placePicker = false;
            await Browser.PlaceDropdownAsync(OpenListId);                                        // impure
        }
        if (refocus is Optional<string>.Some button)
        {
            refocus = Optional.None<string>();
            await Browser.FocusElementAsync(button.Value);                                       // impure
        }
    }

    private void TogglePicker(OpenPick pick)
    {
        var closing = picker == Optional.Some(pick);                                             // pure
        picker = closing ? Optional.None<OpenPick>() : Optional.Some(pick);                      // impure (UI state)
        placePicker = !closing;                                                                  // impure (UI state)
    }

    /// <summary>A tap outside the open dropdown (in the editor) closes it.</summary>
    private void ClosePicker() =>
        picker = Optional.None<OpenPick>();                                                      // impure (UI state)

    /// <summary>Escape with a dropdown open closes the dropdown only, and the focus goes back to its ⋯; with none open it
    /// closes the editor. The editor handles Escape itself, the modal never sees it: Blazor reads a stopPropagation flag
    /// after the handler's render, so a flag that follows the dropdown would already be off.</summary>
    private async Task CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
        {
            return;
        }
        if (picker is Optional<OpenPick>.Some open)
        {
            refocus = Optional.Some(DescribePickButtonId(open.Value));                           // impure (UI state)
            picker = Optional.None<OpenPick>();                                                  // impure (UI state)
            return;
        }
        await OnClose.InvokeAsync();                                                             // impure
    }

    private void Choose(OpenPick pick, ItemHash hash)
    {
        if (pick.Slot == SubclassSlot.Fragment)
        {
            fragmentSlots = PlaceFragment(fragmentSlots, pick.Index, hash);                      // impure (UI state)
        }
        draft = pick.Slot switch                                                                 // pure
        {
            SubclassSlot.Super => draft with { Super = Optional.Some(hash) },
            SubclassSlot.Grenade => draft with { Grenade = Optional.Some(hash) },
            SubclassSlot.Melee => draft with { Melee = Optional.Some(hash) },
            SubclassSlot.ClassAbility => draft with { ClassAbility = Optional.Some(hash) },
            SubclassSlot.Jump => draft with { Jump = Optional.Some(hash) },
            SubclassSlot.Aspect => SetAspects(Place(draft.Aspects, pick.Index, hash)),
            _ => draft,
        };
        refocus = Optional.Some(DescribePickButtonId(pick));                                     // impure (UI state)
        picker = Optional.None<OpenPick>();                                                      // impure (UI state)
    }

    /// <summary>✕ on a fragment: its slot is left empty. An aspect can't be taken out, only swapped (⋯).</summary>
    private void RemoveFragment(int index)
    {
        fragmentSlots = fragmentSlots.SetItem(index, Optional.None<ItemHash>());                  // impure (UI state)
        picker = Optional.None<OpenPick>();                                                      // impure (UI state)
    }

    /// <summary>The list with the plug in slot <paramref name="index"/> (replacing what was there, else added at the end).</summary>
    private static ImmutableArray<ItemHash> Place(ImmutableArray<ItemHash> held, int index, ItemHash hash) =>
        index < held.Length ? held.SetItem(index, hash) : held.Add(hash);

    /// <summary>The fragment slots with the plug in slot <paramref name="index"/> (empty slots before it, when it is past the last one).</summary>
    private static ImmutableArray<Optional<ItemHash>> PlaceFragment(ImmutableArray<Optional<ItemHash>> slots, int index, ItemHash hash) =>
        index < slots.Length
            ? slots.SetItem(index, Optional.Some(hash))
            : [.. slots, .. Enumerable.Repeat(Optional.None<ItemHash>(), index - slots.Length), Optional.Some(hash)];

    /// <summary>
    /// The fragment slots after an aspect change: the fragments <paramref name="kept"/> stay in their slots when every one
    /// of them is in a slot still open, else they are packed from the first slot; the slots past the count close.
    /// </summary>
    private static ImmutableArray<Optional<ItemHash>> KeepFragmentPlaces(ImmutableArray<Optional<ItemHash>> slots, ImmutableArray<ItemHash> kept, Optional<int> count)
    {
        var placed = slots.Select(slot => slot.Bind(hash => kept.Contains(hash) ? Optional.Some(hash) : Optional.None<ItemHash>())).ToImmutableArray();
        var open = count.UnwrapOr(placed.Length);
        return placed.Skip(open).Any(slot => slot.IsSome()) ? [.. kept.Select(Optional.Some)] : [.. placed.Take(open)];
    }

    /// <summary>The draft with these aspects: the fragments their slot count no longer holds are taken out, the last first, and named.</summary>
    private SubclassPlugs SetAspects(ImmutableArray<ItemHash> aspects)
    {
        var trimmed = LoopDesigning.SetSubclassAspects(Build, ReadPlugs(), aspects);             // pure
        var names = trimmed.Removed.Select(hash => LoadoutShaping.DescribeSubclassPlug(Build, hash).Name).ToImmutableArray();
        var count = LoopDesigning.CountFragmentSlots(Build, aspects).Slots;
        var slots = count.UnwrapOr(0);
        fragmentSlots = KeepFragmentPlaces(fragmentSlots, trimmed.Plugs.Fragments, count);      // impure (UI state)
        trimNote = names.IsEmpty                                                                 // impure (UI state)
            ? ""
            : $"Removed {string.Join(", ", names)}: the aspects open {slots} fragment slot{(slots == 1 ? "" : "s")}.";
        return trimmed.Plugs;
    }

    /// <summary>The plugs the editor holds: the draft with the fragments in slot order.</summary>
    private SubclassPlugs ReadPlugs() =>
        draft with { Fragments = [.. fragmentSlots.OfType<Optional<ItemHash>.Some>().Select(slot => slot.Value)] };

    private void OpenDetails(ItemDetails open) =>
        details = Optional.Some(open);                                                           // impure (UI state)

    private void CloseDetails() =>
        details = Optional.None<ItemDetails>();                                                  // impure (UI state)

    private Task SaveAsync() =>
        OnSave.InvokeAsync(ReadPlugs());                                                               // impure
}
