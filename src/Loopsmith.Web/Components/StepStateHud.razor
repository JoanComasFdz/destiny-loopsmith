@* What is present at the end of a step (LoopDesigning.ShapeStepState), laid out like the game's HUD: the buffs on you on
   the left, your weapons' buffs in the middle (each with the weapon whose perk gives it) and what changes those weapons'
   stats right then, the debuffs on the pack on the right, the pickups on the ground below them. A phone stacks them.
   A status that switches other elements' effects on says how many; its details list them. Every status opens its
   details on a tap (Amplified, which has no element, its glossary facts); its facts ("up to x5 · 8s") show on hover.
   Below them, the damage resistance right then: PvE and PvP for all damage, and a PvE line for each resistance against
   some combatants only; tapping its title shows where each comes from and how they multiply. *@
<div class="step-hud" data-testid="step-state">
    <div class="hud-title">State after #@Number</div>
    <div class="hud-columns">
        @RenderGroup("buffs", "Buffs", State.Buffs, false)
        <div class="hud-group" data-group="weapons">
            <span class="hud-label">Weapons</span>
            <span class="chips">
                @if (State.Weapons.IsEmpty && State.WeaponEffects.IsEmpty)
                {
                    <span class="muted">none</span>
                }
                @foreach (var entry in State.Weapons)
                {
                    @RenderEntry(entry, true)
                }
                @foreach (var effect in State.WeaponEffects)
                {
                    @RenderWeaponEffect(effect)
                }
            </span>
        </div>
        @RenderGroup("debuffs", "Debuffs", State.Debuffs, false)
    </div>
    @RenderGroup("ground", "Ground", State.Ground, false)
    @if (State.Resistance is Optional<DamageResistance>.Some resistance)
    {
        var all = resistance.Value.AllDamage;
        <div class="hud-resistance" data-testid="resistance">
            <button type="button" class="hud-resistance-row hud-resistance-head" aria-expanded="@(showResistance ? "true" : "false")"
                    @onclick="ToggleResistance" @onclick:stopPropagation="true">
                <span class="hud-label">@(showResistance ? "▾" : "▸") Damage resistance</span>
                <span class="hud-label hud-resistance-value">PvE</span>
                <span class="hud-label hud-resistance-value">PvP</span>
            </button>
            @RenderResistanceRow("All damage", all.Pve.FormatPercent(), all.Pvp.FormatPercent())
            @foreach (var line in resistance.Value.AgainstSome)
            {
                @RenderResistanceRow(DomainPhrasing.Capitalize(line.Against), line.Pve.FormatPercent(), "—")
            }
            @if (showResistance)
            {
                <div class="hud-resistance-sources" data-testid="resistance-sources">
                    @RenderResistanceSources("All damage", all.Sources, [$"PvE: {all.PveFormula}", $"PvP: {all.PvpFormula}"])
                    @foreach (var line in resistance.Value.AgainstSome)
                    {
                        @RenderResistanceSources($"{DomainPhrasing.Capitalize(line.Against)}: all damage ×", line.Sources, [$"PvE: {line.PveFormula}"])
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public StepState State { get; set; } = null!;

    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>The step this is the state after.</summary>
    [Parameter, EditorRequired]
    public int Number { get; set; }

    /// <summary>A name tapped: what to show the details of.</summary>
    [Parameter]
    public EventCallback<ItemDetails> OnShowDetails { get; set; }

    private RenderFragment RenderGroup(string group, string label, ImmutableArray<StateEntry> entries, bool withWeapons) => __builder =>
    {
        <div class="hud-group" data-group="@group">
            <span class="hud-label">@label</span>
            <span class="chips">
                @if (entries.IsEmpty)
                {
                    <span class="muted">none</span>
                }
                @foreach (var entry in entries)
                {
                    @RenderEntry(entry, withWeapons)
                }
            </span>
        </div>
    };

    /// <summary>A status or pickup: tappable when there are details to show (its element, or — a status — its glossary facts).</summary>
    private RenderFragment RenderEntry(StateEntry entry, bool withWeapons) => __builder =>
    {
        var weapons = withWeapons ? StateHudShaping.ListBuffWeapons(Build, entry) : [];
        var title = StateHudShaping.DescribeEntryTitle(entry);
        if (StateHudShaping.FindEntryDetails(entry) is Optional<ItemDetails>.Some shown)
        {
            <button type="button" class="chip hud-chip @ToneStyling.ToAffinityClass(entry.Affinity)" data-keyword="@entry.Keyword.DescribeKeywordId()" title="@title"
                    @onclick="() => ShowDetailsAsync(shown.Value)" @onclick:stopPropagation="true">
                @RenderEntryIcon(entry)
                <span>@entry.Text</span>
                @RenderSwitches(entry)
                @RenderWeapons(weapons)
            </button>
        }
        else
        {
            <span class="chip hud-chip @ToneStyling.ToAffinityClass(entry.Affinity)" data-keyword="@entry.Keyword.DescribeKeywordId()" title="@title">
                @RenderEntryIcon(entry)
                <span>@entry.Text</span>
                @RenderSwitches(entry)
                @RenderWeapons(weapons)
            </span>
        }
    };

    /// <summary>A change to the stats of some of the build's weapons right then (Ionic Overclock on a Fusion Rifle), with those weapons.</summary>
    private RenderFragment RenderWeaponEffect(WeaponEffect effect) => __builder =>
    {
        <button type="button" class="chip hud-chip @ToneStyling.ToAffinityClass(effect.Affinity)" data-effect="@effect.Source.Value" title="@effect.Text"
                @onclick="() => ShowElementAsync(effect.Source)" @onclick:stopPropagation="true">
            <span>@effect.SourceName</span>
            @RenderWeapons(StateHudShaping.ListWeapons(Build, effect.Weapons))
        </button>
    };

    private bool showResistance;

    /// <summary>A row of the resistance table: what it is against, its PvE and PvP totals ("—": nothing in PvP).</summary>
    private static RenderFragment RenderResistanceRow(string name, string pve, string pvp) => __builder =>
    {
        <div class="hud-resistance-row" data-testid="resistance-line">
            <span class="hud-resistance-name">@name</span>
            <span class="hud-resistance-value" data-column="pve">@pve</span>
            <span class="hud-resistance-value muted" data-column="pvp">@pvp</span>
        </div>
    };

    /// <summary>A row's sources, each with its values and opening its details on a tap, and how they multiply.</summary>
    private RenderFragment RenderResistanceSources(string heading, ImmutableArray<ResistanceSource> sources, string[] formulas) => __builder =>
    {
        <div class="hud-resistance-source-line">
            <span class="hud-label">@heading</span>
            <span class="chips">
                @foreach (var source in sources)
                {
                    <button type="button" class="chip hud-chip @ToneStyling.ToAffinityClass(source.Affinity)" data-effect="@source.Element.Value"
                            @onclick="() => ShowElementAsync(source.Element)" @onclick:stopPropagation="true">
                        <span>@source.Name</span>
                        <span class="hud-switches">@StateHudShaping.DescribeResistanceSource(source)</span>
                    </button>
                }
            </span>
            @foreach (var formula in formulas)
            {
                <span class="hud-resistance-formula">@formula</span>
            }
        </div>
    };

    private void ToggleResistance() =>
        showResistance = !showResistance;

    private async Task ShowElementAsync(ElementId element)
    {
        var details = new ItemDetails.OfElement(element);                                       // pure
        await ShowDetailsAsync(details);                                                         // impure
    }

    private async Task ShowDetailsAsync(ItemDetails details) =>
        await OnShowDetails.InvokeAsync(details);                                                // impure

    /// <summary>A status's or pickup's icon (the game's own keyword icon, or the shape it draws), when it has one.</summary>
    private RenderFragment RenderEntryIcon(StateEntry entry) => __builder =>
    {
        if (LoopDesigning.FindKeywordIcon(Build, entry.Keyword) is Optional<IconRef>.Some icon)
        {
            <img class="inline-icon hud-keyword-icon" src="@LoadoutShaping.ToIconUrl(icon.Value)" alt="" loading="lazy" />
        }
    };

    private static RenderFragment RenderSwitches(StateEntry entry) => __builder =>
    {
        if (!entry.SwitchesOn.IsEmpty)
        {
            <span class="hud-switches" data-testid="switches-on">@StateHudShaping.DescribeSwitchesCount(entry)</span>
        }
    };

    private static RenderFragment RenderWeapons(ImmutableArray<BuffWeapon> weapons) => __builder =>
    {
        foreach (var weapon in weapons)
        {
            <span class="hud-weapon" data-testid="buff-weapon">
                @if (weapon.Icon is Optional<string>.Some icon)
                {
                    <img src="@icon.Value" alt="" loading="lazy" />
                }
                <span>@weapon.Name</span>
            </span>
        }
    };
}
