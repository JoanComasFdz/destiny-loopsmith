@* The designed loop: one card per step with what it fired (LoopDesigning.RenderStepOutcomes — the CLI's wording).
   Each step can be moved up or down, removed, or (with a mouse) dragged by its handle onto another step's place. *@
@{
    var build = Session.Build;
    var glossary = build.Catalog.Glossary;
    var steps = Session.Design.Steps;
}
<section class="timeline" aria-label="Loop timeline">
    <article class="step-card spawn @(IsSelected(0) ? "selected" : "") @DescribeDropTarget(0)" data-step="0" tabindex="0"
             @onclick="() => SelectStep(0)" @onkeydown="e => SelectStepByKey(e, 0)"
             @ondragenter="() => EnterDropTarget(0)" @ondragover:preventDefault="true" @ondrop="() => DropOnAsync(0)" @ondrop:preventDefault="true">
        <header class="step-head">
            <span class="step-no">#0</span>
            <span class="step-title">Fresh spawn</span>
            <span class="step-meta muted">where the loop starts</span>
        </header>
        @if (IsSelected(0) && !steps.IsEmpty)
        {
            <div class="step-actions" @onclick:stopPropagation="true">
                <button class="btn small" @onclick="() => BranchFromStep(0)">Branch from here</button>
                <span class="muted">drops all @steps.Length steps</span>
            </div>
        }
    </article>

    @for (var i = 0; i < steps.Length && i < Session.Resolutions.Length; i++)
    {
        var index = i;
        var number = i + 1;
        var step = steps[index];
        var resolution = Session.Resolutions[index];
        var blocked = resolution.Blocked.IsSome();
        <article class="step-card @(IsSelected(number) ? "selected" : "") @(blocked ? "blocked" : "") @(number == steps.Length ? "last" : "") @DescribeDropTarget(number) @(IsDragged(index) ? "dragged" : "")"
                 id="step-@number" data-step="@number" tabindex="0"
                 @onclick="() => SelectStep(number)" @onkeydown="e => SelectStepByKey(e, number)"
                 @ondragenter="() => EnterDropTarget(number)" @ondragover:preventDefault="true" @ondrop="() => DropOnAsync(number)" @ondrop:preventDefault="true">
            <header class="step-head">
                <span class="step-drag" draggable="true" title="Drag to move this step" aria-hidden="true" data-step="@number"
                      @ondragstart="() => StartDrag(index)" @ondragend="EndDrag" @onclick:stopPropagation="true">⠿</span>
                <span class="step-no">#@number</span>
                <span class="step-title">@glossary.DescribeAction(step.Action, build.Build)</span>
                <code class="token">@step.Action.ToActionToken()</code>
                @if (blocked)
                {
                    <span class="badge blocked" title="@resolution.Blocked.UnwrapOr("")">Blocked</span>
                }
                <span class="step-tools" @onclick:stopPropagation="true">
                    <button type="button" class="icon-btn" disabled="@(index == 0)" title="Move up" aria-label="@($"Move step {number} up")"
                            data-action="step-up" @onclick="() => MoveStepAsync(index, index - 1)">↑</button>
                    <button type="button" class="icon-btn" disabled="@(index == steps.Length - 1)" title="Move down" aria-label="@($"Move step {number} down")"
                            data-action="step-down" @onclick="() => MoveStepAsync(index, index + 1)">↓</button>
                    <button type="button" class="icon-btn remove" title="Remove this step" aria-label="@($"Remove step {number}")"
                            data-action="step-remove" @onclick="() => OnRemove.InvokeAsync(index)">✕</button>
                </span>
            </header>
            <div class="step-body">
                <StyledLines Lines="@RenderStepLines(resolution)" IndentBase="1" />
            </div>
            <div class="step-note" @onclick:stopPropagation="true">
                <input class="note-input" placeholder="Add a note…" aria-label="@($"Note for step {number}")"
                       value="@step.Note.UnwrapOr("")" @onchange="e => AnnotateStep(index, e)" />
            </div>
            @if (IsSelected(number) && number < steps.Length)
            {
                <div class="step-actions" @onclick:stopPropagation="true">
                    <button class="btn small" @onclick="() => BranchFromStep(number)">Branch from here</button>
                    <span class="muted">keeps #1–#@number, drops @(steps.Length - number) later step@(steps.Length - number == 1 ? "" : "s")</span>
                </div>
            }
        </article>
    }

    @if (steps.IsEmpty)
    {
        <p class="timeline-empty">Pick a trigger to start the loop. Each step shows everything it fires, which element caused it, and what it unlocks next.</p>
    }
</section>

@code {
    private readonly Dictionary<object, ImmutableArray<StyledLine>> renderedSteps = new(ReferenceEqualityComparer.Instance);
    private TraceOptions renderedWith = new(false, false, false);

    [Parameter, EditorRequired]
    public DesignSession Session { get; set; } = null!;

    [Parameter]
    public Optional<int> Selected { get; set; } = Optional.None<int>();

    [Parameter]
    public TraceOptions Options { get; set; } = new(false, false, false);

    [Parameter]
    public EventCallback<int> OnSelect { get; set; }

    [Parameter]
    public EventCallback<int> OnBranch { get; set; }

    [Parameter]
    public EventCallback<(int Index, string Note)> OnAnnotate { get; set; }

    /// <summary>A step to remove (0-based).</summary>
    [Parameter]
    public EventCallback<int> OnRemove { get; set; }

    /// <summary>A step to move (0-based): from its place to another (its place after the move).</summary>
    [Parameter]
    public EventCallback<(int From, int To)> OnMove { get; set; }

    // A drag under way: the step dragged (0-based) and the card it is over (its number: 0 is the spawn, the first place).
    private Optional<int> dragged = Optional.None<int>();
    private Optional<int> dropTarget = Optional.None<int>();

    protected override void OnParametersSet()
    {
        if (renderedWith != Options)
        {
            renderedSteps.Clear();
            renderedWith = Options;
        }

        var current = Session.Resolutions.Cast<object>().ToHashSet(ReferenceEqualityComparer.Instance);
        foreach (var stale in renderedSteps.Keys.Where(key => !current.Contains(key)).ToList())
        {
            renderedSteps.Remove(stale);
        }
    }

    /// <summary>The step's lines without its header (the card draws its own); cached per resolution.</summary>
    private ImmutableArray<StyledLine> RenderStepLines(Resolution resolution)
    {
        if (!renderedSteps.TryGetValue(resolution, out var lines))
        {
            lines = LoopDesigning.RenderStepOutcomes(Session, resolution, Options with { ShowState = false });
            renderedSteps[resolution] = lines;
        }

        return lines;
    }

    private bool IsSelected(int number) =>
        Selected.Match(some => some.Value == number, _ => false);

    private Task SelectStep(int number) =>
        OnSelect.InvokeAsync(number);

    private Task SelectStepByKey(KeyboardEventArgs e, int number) =>
        e.Key is "Enter" or " " ? OnSelect.InvokeAsync(number) : Task.CompletedTask;

    private Task BranchFromStep(int number) =>
        OnBranch.InvokeAsync(number);

    private Task AnnotateStep(int index, ChangeEventArgs e) =>
        OnAnnotate.InvokeAsync((index, e.Value?.ToString() ?? ""));

    private Task MoveStepAsync(int from, int to) =>
        OnMove.InvokeAsync((from, to));

    private void StartDrag(int index)
    {
        dragged = Optional.Some(index);
        dropTarget = Optional.None<int>();
    }

    private void EndDrag()
    {
        dragged = Optional.None<int>();
        dropTarget = Optional.None<int>();
    }

    private void EnterDropTarget(int number) =>
        dropTarget = dragged.IsSome() ? Optional.Some(number) : Optional.None<int>();

    /// <summary>A step dropped on a card takes that card's place (on the spawn: the first place).</summary>
    private async Task DropOnAsync(int number)
    {
        var move = dragged.Map(from => (From: from, To: ToDropPlace(number)));
        EndDrag();
        if (move is Optional<(int From, int To)>.Some { Value: var chosen } && chosen.From != chosen.To)
        {
            await OnMove.InvokeAsync(chosen);
        }
    }

    private static int ToDropPlace(int number) =>
        Math.Max(number - 1, 0);

    private bool IsDragged(int index) =>
        dragged.Match(some => some.Value == index, _ => false);

    /// <summary>
    /// Where the dragged step would land, drawn as a line on the card it is over: above it when the step moves up, below
    /// it when it moves down (below the spawn: the first place). None when it would stay where it is.
    /// </summary>
    private string DescribeDropTarget(int number)
    {
        if (dragged is not Optional<int>.Some from || dropTarget is not Optional<int>.Some target || target.Value != number)
        {
            return "";
        }

        var place = ToDropPlace(number);
        return place == from.Value ? "" : number > 0 && place < from.Value ? "drop-before" : "drop-after";
    }
}
