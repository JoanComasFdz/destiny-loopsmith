@* DIM-like build sheet: what is equipped, coloured by element, plus the validation issues. *@
@{
    var sheet = BuildSheetShaping.ShapeSheet(Build, Issues);
}
<section class="panel build-panel @ToneStyling.ToAffinityClass(sheet.Subclass)" aria-label="Build">
    <header class="build-head">
        @if (sheet.SubclassIcon is Optional<string>.Some subclassIcon)
        {
            <img class="build-emblem-icon" src="@subclassIcon.Value" alt="" width="40" height="40" />
        }
        else
        {
            <div class="build-emblem" aria-hidden="true">@sheet.Subclass.ToString()[..1]</div>
        }
        <div class="build-title">
            <div class="build-name">@sheet.Name</div>
            <div class="build-sub">@sheet.Class · <span class="accent">@sheet.Subclass</span></div>
            @if (sheet.Author.IsSome() || sheet.SourceUrl.IsSome())
            {
                <div class="build-src">
                    @if (sheet.Author is Optional<string>.Some by)
                    {
                        <span>@by.Value</span>
                    }
                    @if (sheet.SourceUrl is Optional<string>.Some url && IsWebLink(url.Value))
                    {
                        <a href="@url.Value" target="_blank" rel="noopener noreferrer">@(LoopDesigning.IsDimLink(url.Value) ? "DIM link" : "source") ↗</a>
                    }
                </div>
            }
        </div>
    </header>

    <LoadoutPanel Build="Build" OnPickPerk="OnPickPerk" OnSetCatalyst="OnSetCatalyst" Profile="Profile" OnPickArmor="OnPickArmor" OnPickWeapon="OnPickWeapon" OnEditSubclass="OnEditSubclass"
                  OnEditArtifact="OnEditArtifact" RememberedArtifactPerks="RememberedArtifactPerks"
                  PickWeaponItem="PickWeaponItem" PickArmorItem="PickArmorItem" OnEmptyWeapon="OnEmptyWeapon" OnEmptyArmor="OnEmptyArmor"
                  PickMod="PickMod" ClearMod="ClearMod" />

    <StatsPanel Build="Build" OnSetStats="OnSetStats" Profile="Profile" Note="LoginNote" OnLoggedIn="OnLoggedIn" OnLoggedOut="OnLoggedOut" />

    @if (!sheet.LeftOut.IsEmpty)
    {
        @* Collapsed until opened: what the build leaves out is a list to look up, not part of the loop. *@
        <details class="left-out-section" data-testid="left-out-section">
            <summary class="section-label">Not in Loopsmith yet <span class="left-out-count">@LoopDesigning.ListMissing(Build).DescribeLeftOut()</span></summary>
            <p class="left-out-note muted">The DIM loadout has these, but no rule knows them yet, so the build leaves them out (they carry a ⊘ above). Each opens on light.gg.</p>
            @foreach (var group in sheet.LeftOut)
            {
                <div class="left-out" data-testid="left-out">
                    <span class="left-out-label">@group.Label</span>
                    <div class="chips">
                        @foreach (var entry in group.Entries)
                        {
                            <a class="chip left-out-hash" href="@ToLookupUrl(entry.Hash)" target="_blank" rel="noopener noreferrer" title="@entry.Name (@entry.Hash.Value) on light.gg">@entry.Name@(entry.Copies > 1 ? $" ×{entry.Copies}" : "") ↗</a>
                        }
                    </div>
                </div>
            }
        </details>
    }

    @if (!sheet.Issues.IsEmpty)
    {
        <h3 class="section-label">Validation</h3>
        <ul class="issues">
            @foreach (var issue in sheet.Issues)
            {
                <li class="issue @(issue.Severity == Severity.Warning ? "warning" : "info")">
                    <span class="issue-mark">@(issue.Severity == Severity.Warning ? "!" : "i")</span>
                    <span>@issue.Message</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>What to list under Validation (the design's issues, see <c>LoopDesigning.ListDesignIssues</c>).</summary>
    [Parameter, EditorRequired]
    public ImmutableArray<BuildIssue> Issues { get; set; }

    /// <summary>A perk picked in the loadout (the designer applies it to the design).</summary>
    [Parameter]
    public EventCallback<PerkPick> OnPickPerk { get; set; }

    /// <summary>An exotic's catalyst turned on or off in its details (the designer applies it to the design).</summary>
    [Parameter]
    public EventCallback<CatalystToggle> OnSetCatalyst { get; set; }

    /// <summary>Stats typed in the Stats section (the designer applies them); none: shown only.</summary>
    [Parameter]
    public EventCallback<StatLine> OnSetStats { get; set; }

    /// <summary>The player's armor and weapons after their Bungie login: the pickers list theirs too (none: logged out).</summary>
    [Parameter]
    public Optional<BungieProfile> Profile { get; set; } = Optional.None<BungieProfile>();

    /// <summary>What the Stats section says after the login.</summary>
    [Parameter]
    public Optional<string> LoginNote { get; set; } = Optional.None<string>();

    /// <summary>The login read the player's profile (the designer keeps it).</summary>
    [Parameter]
    public EventCallback<BungieProfile> OnLoggedIn { get; set; }

    /// <summary>The player logged out (the designer forgets their armor; the build keeps its stats and pieces).</summary>
    [Parameter]
    public EventCallback OnLoggedOut { get; set; }

    /// <summary>A piece picked from the player's armor for a slot (the designer swaps it into the build).</summary>
    [Parameter]
    public EventCallback<ArmorPick> OnPickArmor { get; set; }

    /// <summary>A weapon picked from the player's weapons for a slot (the designer swaps it into the build, or adds it).</summary>
    [Parameter]
    public EventCallback<WeaponPick> OnPickWeapon { get; set; }

    /// <summary>A weapon of the game picked from "Every item" (the designer reads it from Bungie's manifest and puts it in, or says why not).</summary>
    [Parameter]
    public Optional<Func<WeaponItemPick, Task<Result<Unit, string>>>> PickWeaponItem { get; set; } = Optional.None<Func<WeaponItemPick, Task<Result<Unit, string>>>>();

    /// <summary>A piece of the game picked from "Every item" (the designer reads it from Bungie's manifest and puts it in, or says why not).</summary>
    [Parameter]
    public Optional<Func<ArmorItemPick, Task<Result<Unit, string>>>> PickArmorItem { get; set; } = Optional.None<Func<ArmorItemPick, Task<Result<Unit, string>>>>();

    /// <summary>A mod picked for a socket (the designer reads it from Bungie's manifest when needed and puts it in, or says why not).</summary>
    [Parameter]
    public Optional<Func<ModPick, Task<Result<Unit, string>>>> PickMod { get; set; } = Optional.None<Func<ModPick, Task<Result<Unit, string>>>>();

    /// <summary>"Clear this socket": the designer takes the mod there out (or says why not).</summary>
    [Parameter]
    public Optional<Func<ModSocketPlace, Task<Result<Unit, string>>>> ClearMod { get; set; } = Optional.None<Func<ModSocketPlace, Task<Result<Unit, string>>>>();

    /// <summary>"Empty this slot" on a weapon (its number): the designer takes it off.</summary>
    [Parameter]
    public EventCallback<int> OnEmptyWeapon { get; set; }

    /// <summary>"Empty this slot" on an armor slot: the designer takes its piece off.</summary>
    [Parameter]
    public EventCallback<ArmorSlot> OnEmptyArmor { get; set; }

    /// <summary>The subclass editor's Save: the plugs the subclass now holds.</summary>
    [Parameter]
    public EventCallback<SubclassPlugs> OnEditSubclass { get; set; }

    /// <summary>The artifact editor's Save: the artifact and its perks, and what was picked for each artifact.</summary>
    [Parameter]
    public EventCallback<ArtifactSave> OnEditArtifact { get; set; }

    /// <summary>The perks last picked for each artifact while the loop is open.</summary>
    [Parameter]
    public ImmutableDictionary<ItemHash, ImmutableArray<ItemHash>> RememberedArtifactPerks { get; set; } = ImmutableDictionary<ItemHash, ImmutableArray<ItemHash>>.Empty;

    /// <summary>light.gg's page for a manifest hash: what the item is, until Loopsmith reads the manifest itself.</summary>
    private static string ToLookupUrl(ItemHash hash) =>
        $"https://www.light.gg/db/items/{hash.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}/";

    private static bool IsWebLink(string url) =>
        url.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || url.StartsWith("http://", StringComparison.OrdinalIgnoreCase);
}
