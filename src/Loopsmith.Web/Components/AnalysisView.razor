@* A LoopReport (LoopDesigning.AnalyzeDesign): the loop played back to back, cycle after cycle.
   Every figure comes from the core (LoopReportArithmetic, Phrasing); this only lays it out. *@
@{
    var repeatable = Report.IsRepeatable();
    var steady = Report.FindSteadyCycle();
    var block = ReportReading.FindFirstBlock(Report);
    var sources = ReportReading.ListTopSources(Report, 10);
    var topFired = sources.IsEmpty ? 0 : sources.Max(source => source.Fired);
}
<div class="analysis">
    <div class="analysis-head">
        <div>
            <div class="analysis-name">@Report.LoopName</div>
            <div class="muted">@Report.BuildName · @Report.StepCount step@(Report.StepCount == 1 ? "" : "s") per cycle · up to @Report.MaxCycles cycles</div>
        </div>
        <span class="badge big @(repeatable ? "ok" : "warn")" data-testid="repeatable">@ReportReading.DescribeRepeatability(Report)</span>
    </div>

    @if (Report.Cycles.IsEmpty)
    {
        <p class="notice">Add steps to the loop, then analyze it.</p>
    }

    @if (block is Optional<CycleBlock>.Some blocked)
    {
        <p class="notice warn" data-testid="breaks">
            Breaks in cycle @blocked.Value.Cycle at step #@(blocked.Value.Step.StepIndex + 1)
            <code class="token">@blocked.Value.Step.Action.ToActionToken()</code>: @blocked.Value.Step.Reason
        </p>
    }

    @if (steady is Optional<CycleRun>.Some steadyCycle)
    {
        <h3 class="section-label">
            Wasted per cycle
            <span class="label-note">steady state = cycle @steadyCycle.Value.Number · rules that gave nothing because they don't stack</span>
        </h3>
        @if (Report.Wasted.IsEmpty)
        {
            <p class="muted" data-testid="wasted">Nothing wasted — everything that fired stacked.</p>
        }
        else
        {
            <ul class="tallies wasted" data-testid="wasted">
                @foreach (var wasted in Report.Wasted)
                {
                    <li><span>@wasted.DescribeWasted()</span><strong>×@wasted.Count</strong></li>
                }
            </ul>
        }
    }

    <div class="analysis-grid">
        <div>
            <h3 class="section-label">Per cycle</h3>
            @if (Report.Outcomes.IsEmpty)
            {
                <p class="muted">Nothing counted.</p>
            }
            else
            {
                <ul class="tallies">
                    @foreach (var tally in Report.Outcomes)
                    {
                        <li><span>@tally.Label</span><strong>@tally.Count</strong></li>
                    }
                </ul>
            }
            <ul class="tallies caveats">
                <li title="Outcomes whose value is unknown (?) are shown but not applied — the real loop is stronger.">
                    <span>Unknown values (?) not applied</span><strong>@Report.UnknownValues</strong>
                </li>
                <li title="Bullets marked (chance) fire in the simulation but are not guaranteed in game.">
                    <span>Chance bullets</span><strong>@Report.ChanceRules</strong>
                </li>
            </ul>
        </div>
        <div>
            <h3 class="section-label">Buff uptime</h3>
            @if (Report.Uptime.IsEmpty)
            {
                <p class="muted">No buffs measured.</p>
            }
            @foreach (var uptime in Report.Uptime)
            {
                <div class="meter @ToneStyling.ToAffinityClass(uptime.Affinity)" title="@($"active after {uptime.StepsActive} of {uptime.Steps} steps")">
                    <span class="meter-label">@uptime.Name</span>
                    <span class="meter-bar"><span style="width:@ToPercent(uptime.ComputeUptimeRatio())%"></span></span>
                    <span class="meter-value">@uptime.StepsActive/@uptime.Steps</span>
                </div>
            }
        </div>
        <div>
            <h3 class="section-label">Top sources</h3>
            @if (sources.IsEmpty)
            {
                <p class="muted">Nothing fired.</p>
            }
            @foreach (var source in sources)
            {
                <div class="meter @ToneStyling.ToAffinityClass(source.Affinity)">
                    <span class="meter-label">@source.SourceName</span>
                    <span class="meter-bar"><span style="width:@ToPercent(ReportReading.ToRatio(source.Fired, topFired))%"></span></span>
                    <span class="meter-value">×@source.Fired</span>
                </div>
            }
        </div>
    </div>

    <details class="report-text">
        <summary>The report as text (same as <code>loopsmith loop</code>)</summary>
        <StyledLines Lines="@LoopDesigning.RenderLoopReport(Report)" Preformatted="true" />
    </details>
</div>

@code {
    [Parameter, EditorRequired]
    public LoopReport Report { get; set; } = null!;

    private static string ToPercent(decimal ratio) =>
        (ratio * 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
