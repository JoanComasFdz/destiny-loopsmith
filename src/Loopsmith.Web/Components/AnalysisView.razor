@* A LoopReport (LoopDesigning.AnalyzeDesign): the loop by its order of triggers — the verdict, the step chain, then
   each step of the repeating pass with what it needs and which step provided it, what it sets off in this order and on
   its own, what is wasted there, and where the first pass from a fresh spawn differs. Every word comes from the core's
   Phrasing; this only lays it out. *@
<div class="analysis">
    <div class="analysis-head">
        <div>
            <div class="analysis-name">@Report.LoopName</div>
            <div class="muted">@Report.BuildName · @Report.StepLabels.Length step@(Report.StepLabels.Length == 1 ? "" : "s")</div>
        </div>
        <span class="badge big @(Report.Verdict is LoopVerdict.Repeats ? "ok" : "warn")" data-testid="verdict">@Report.Verdict.DescribeShortVerdict()</span>
    </div>

    @if (Report.Verdict is LoopVerdict.NoSteps)
    {
        <p class="notice">Add steps to the loop, then analyze it.</p>
    }
    else
    {
        <p class="analysis-order" data-testid="order">@string.Join(" → ", Report.StepLabels)</p>
        <p class="notice @(Report.Verdict is LoopVerdict.Breaks ? "warn" : "")" data-testid="verdict-text">@Report.Verdict.DescribeVerdict()</p>

        <h3 class="section-label">Chain <span class="label-note">which step feeds which — tap a step</span></h3>
        <StepChain Report="Report" Links="ChainShaping.ListPlainLinks(Report.Links)" />

        <div class="analysis-steps-head">
            <h3 class="section-label">Steps</h3>
            <label class="toggle" title="Also list what each step sets off wherever it goes in the loop">
                <input type="checkbox" checked="@showOnItsOwn" @onchange="ToggleOnItsOwn" data-testid="toggle-on-its-own" /> on its own
            </label>
        </div>
        <ol class="analysis-steps" data-testid="steps">
            @foreach (var step in Report.Steps)
            {
                <li class="analysis-step @(step.Blocked.IsSome() ? "blocked" : "")">
                    <div class="analysis-step-head"><span class="muted">#@(step.StepIndex + 1)</span> <strong>@step.Label</strong></div>
                    @if (step.Blocked is Optional<string>.Some blocked)
                    {
                        <div class="analysis-field warn"><span class="field-label">blocked</span><span>@blocked.Value</span></div>
                    }
                    @if (!step.Needs.IsEmpty)
                    {
                        <div class="analysis-field" data-testid="needs">
                            <span class="field-label">needs</span>
                            <span class="chips">
                                @foreach (var need in step.Needs)
                                {
                                    <span class="chip @ToneStyling.ToAffinityClass(need.Affinity)">@need.DescribeNeed()</span>
                                }
                            </span>
                        </div>
                    }
                    @if (!step.InOrder.IsEmpty)
                    {
                        <div class="analysis-field" data-testid="in-order">
                            <span class="field-label" title="Fires here because an earlier step provided what it needs">in this order</span>
                            @RenderMentions(step.InOrder)
                        </div>
                    }
                    @if (showOnItsOwn && !step.OnItsOwn.IsEmpty)
                    {
                        <div class="analysis-field" data-testid="on-its-own">
                            <span class="field-label" title="Fires wherever this step goes in the loop">on its own</span>
                            @RenderMentions(step.OnItsOwn)
                        </div>
                    }
                    @foreach (var wasted in step.Wasted)
                    {
                        <div class="analysis-field warn" data-testid="wasted"><span class="field-label">wasted</span><span>@wasted.DescribeWasted()</span></div>
                    }
                </li>
            }
        </ol>

        @if (!Report.FirstPassDifferences.IsEmpty)
        {
            <h3 class="section-label">First pass <span class="label-note">from a fresh spawn, where it differs</span></h3>
            <ul class="analysis-steps first-pass" data-testid="first-pass">
                @foreach (var difference in Report.FirstPassDifferences)
                {
                    <li class="analysis-step">
                        <div class="analysis-step-head"><span class="muted">#@(difference.StepIndex + 1)</span> <strong>@difference.Label</strong></div>
                        @if (difference.BlockedOnFirstPass is Optional<string>.Some firstBlocked)
                        {
                            <div class="analysis-field warn"><span class="field-label">blocked</span><span>@firstBlocked.Value</span></div>
                        }
                        @if (!difference.OnlyInRepeatingPass.IsEmpty)
                        {
                            <div class="analysis-field"><span class="field-label">doesn't set off</span><span>@string.Join(" · ", difference.OnlyInRepeatingPass.Select(element => element.DescribeMention()))</span></div>
                        }
                        @if (!difference.OnlyOnFirstPass.IsEmpty)
                        {
                            <div class="analysis-field"><span class="field-label">only here</span><span>@string.Join(" · ", difference.OnlyOnFirstPass.Select(element => element.DescribeMention()))</span></div>
                        }
                    </li>
                }
            </ul>
        }
    }

    <details class="report-text">
        <summary>The report as text (same as <code>loopsmith loop</code>)</summary>
        <StyledLines Lines="@LoopDesigning.RenderLoopReport(Report)" Preformatted="true" />
    </details>
</div>

@code {
    [Parameter, EditorRequired]
    public LoopReport Report { get; set; } = null!;

    private bool showOnItsOwn = true;

    private void ToggleOnItsOwn(ChangeEventArgs e) => showOnItsOwn = e.Value is true;

    private static RenderFragment RenderMentions(ImmutableArray<ElementMention> mentions) => __builder =>
    {
        <span class="chips">
            @foreach (var element in mentions)
            {
                <span class="chip @ToneStyling.ToAffinityClass(element.Affinity)">@element.DescribeMention()</span>
            }
        </span>
    };
}
