@* The artifact editor, laid out like the game's artifact screen (Artifacts 2.0): the artifact's icon, name and "Artifact"
   as its header, with ⋯ beside the name, which opens a dropdown of every artifact (and "No artifact"); the artifact's
   perks in three columns, Tier 1 to Tier 3, seven each; under them the seven perk slots in their groups — two take
   Tier 1, three Tiers 1–2, two Tiers 1–3 — holding the perks picked, and the counts (7 perks, 5 of Tiers 2–3, 2 of
   Tier 3). Tapping a perk makes it active, or takes it out when it is; a perk that would break a count is dimmed and
   only shows its details. The details of the perk last tapped (or hovered) show beside the board, like the game's
   tooltip: its name, tier, "Requirements not met" and why, and Bungie's text; "What it does" opens its full details. A
   perk the rules don't know carries ⊘ and can still be picked. Switching to another artifact shows the perks last
   picked for it while the loop is open (none for one not set up yet); switching back brings the earlier picks back.
   Save hands the artifact, its perks and what was picked for each artifact to the designer (LoopDesigning.EditArtifact);
   Cancel, ✕ or Escape throws the changes away. *@
@inject BrowserInterop Browser
@{
    var item = artifact.Bind(hash => Artifacts.Where(found => found.Hash == hash).Select(Optional.Some).FirstOrDefault(Optional.None<ManifestItem>()));
    var board = artifact.Bind(hash => ArtifactShaping.ShapeBoard(Build, hash, perks));
    var shown = artifact.Bind(hash => focus.Bind(perk => ArtifactShaping.DescribeDetails(Build, hash, perks, perk)));
}
<Modal Title="@(item.Match(found => $"{found.Value.Name}, Artifact", _ => "Artifact"))" Size="snug" OnClose="OnClose">
    <Heading>
        <div class="sub-head art-head" data-testid="artifact-head" @onkeydown="CloseOnEscape" @onkeydown:stopPropagation="true">
            @if (item is Optional<ManifestItem>.Some headItem)
            {
                @RenderTile(ArtifactShaping.DescribeArtifact(headItem.Value), "sub-head-icon art-head-icon", true)
            }
            else
            {
                <span class="icon-tile empty sub-head-icon art-head-icon" aria-hidden="true">?</span>
            }
            <div class="sub-head-text">
                <h2 class="sub-head-name" data-testid="artifact-name">@item.Match(found => found.Value.Name, _ => "No artifact")</h2>
                <span class="sub-head-kind" data-testid="artifact-kind">Artifact</span>
            </div>
            <div class="art-switch @(listOpen ? "open" : "")">
                <button type="button" class="btn ghost small art-switch-button" id="@SwitchButtonId" data-action="switch-artifact"
                        aria-expanded="@(listOpen ? "true" : "false")" aria-controls="@(listOpen ? OpenListId : null)"
                        title="Pick another artifact" aria-label="Pick another artifact" @onclick="ToggleList" @onclick:stopPropagation="true">⋯</button>
                @if (listOpen)
                {
                    @RenderArtifactList()
                }
            </div>
        </div>
    </Heading>
    <ChildContent>
        <div class="artifact-editor" data-testid="artifact-editor" @onclick="CloseList" @onkeydown="CloseOnEscape" @onkeydown:stopPropagation="true">
            @if (board is Optional<ArtifactBoard>.Some shownBoard)
            {
                <div class="art-layout">
                    <div class="art-board">
                        <div class="art-columns" data-testid="artifact-columns">
                            @foreach (var column in shownBoard.Value.Columns)
                            {
                                <section class="art-column" aria-label="@column.Heading" data-tier="@column.Tier">
                                    <h3 class="sub-heading art-column-heading">@column.Heading</h3>
                                    <div class="art-perks">
                                        @foreach (var cell in column.Perks)
                                        {
                                            @RenderPerk(cell)
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                        @if (shownBoard.Value.Slots is Optional<ImmutableArray<ArtifactSlotGroup>>.Some slots)
                        {
                            <div class="art-slots" data-testid="artifact-slots" aria-label="Perk slots">
                                @foreach (var group in slots.Value)
                                {
                                    <div class="art-slot-group" data-tier="@group.Tier">
                                        <span class="art-slot-label">@group.Label</span>
                                        <div class="art-slot-row">
                                            @foreach (var slot in group.Slots)
                                            {
                                                @if (slot is Optional<IconTile>.Some held)
                                                {
                                                    @RenderTile(held.Value, "art-slot", false)
                                                }
                                                else
                                                {
                                                    <span class="icon-tile empty art-slot" title="@group.Label: empty" aria-label="@group.Label: empty"></span>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="tone-warning sub-note" role="status" data-testid="artifact-overfull">These perks don't fit the artifact's slots: take some out.</p>
                        }
                        <div class="art-counts" data-testid="artifact-counts">
                            @foreach (var count in shownBoard.Value.Counts)
                            {
                                <span class="art-count @(count.Full ? "full" : "")">@count.Text</span>
                            }
                        </div>
                    </div>
                    <aside class="art-details" data-testid="artifact-details" aria-live="polite">
                        @if (shown is Optional<ArtifactPerkDetails>.Some perkDetails)
                        {
                            @RenderDetails(perkDetails.Value)
                        }
                        else
                        {
                            <p class="muted art-hint">Tap a perk to make it active, or to take it out. Its details show here.</p>
                        }
                    </aside>
                </div>
            }
            else
            {
                <p class="muted art-hint" data-testid="artifact-none">No artifact. Pick one:</p>
                <div class="art-choices" data-testid="artifact-choices">
                    @RenderArtifactOptions(false)
                </div>
            }
            <div class="sub-foot">
                <button type="button" class="btn" data-action="artifact-cancel" @onclick="OnClose">Cancel</button>
                <button type="button" class="btn primary" data-action="artifact-save" @onclick="SaveAsync">Save</button>
            </div>
        </div>
    </ChildContent>
</Modal>

@if (details is Optional<ItemDetails>.Some open && ItemInfoShaping.ShapeInfo(Build, open.Value) is Optional<ItemInfo>.Some info)
{
    <ItemInfoDialog Info="info.Value" OnClose="CloseDetails" />
}

@code {
    /// <summary>The id of the open artifact list: it is placed under (or above) ⋯ once it is shown.</summary>
    private const string OpenListId = "artifact-open-list";
    private const string SwitchButtonId = "artifact-switch";

    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    /// <summary>The perks last picked for each artifact while the loop is open (the designer keeps them).</summary>
    [Parameter]
    public ImmutableDictionary<ItemHash, ImmutableArray<ItemHash>> Remembered { get; set; } = ImmutableDictionary<ItemHash, ImmutableArray<ItemHash>>.Empty;

    /// <summary>Save: the artifact, its perks and what was picked for each artifact. The designer replays the loop with them.</summary>
    [Parameter]
    public EventCallback<ArtifactSave> OnSave { get; set; }

    /// <summary>Cancel, ✕ or Escape: the editor closes and its changes are thrown away.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private ImmutableArray<ManifestItem> Artifacts = [];
    private Optional<ItemHash> artifact = Optional.None<ItemHash>();
    private ImmutableArray<ItemHash> perks = [];
    private ImmutableDictionary<ItemHash, ImmutableArray<ItemHash>> remembered = ImmutableDictionary<ItemHash, ImmutableArray<ItemHash>>.Empty;
    private Optional<ItemHash> focus = Optional.None<ItemHash>();
    private Optional<ItemDetails> details = Optional.None<ItemDetails>();
    private bool listOpen;
    private bool placeList;
    private bool refocus;

    protected override void OnInitialized()
    {
        var held = LoopDesigning.ReadArtifactChoice(Build);                                     // pure
        Artifacts = LoopDesigning.ListArtifacts(Build);                                         // pure
        artifact = held.Artifact;                                                                // impure (UI state)
        perks = held.Perks;                                                                      // impure (UI state)
        remembered = held.Artifact.Match(found => Remembered.SetItem(found.Value, held.Perks), _ => Remembered); // pure
    }

    /// <summary>A perk of the columns: a button that makes it active or takes it out (a dimmed one only shows its details).</summary>
    private RenderFragment RenderPerk(ArtifactPerkCell cell) => __builder =>
    {
        var blocked = cell.Blocked.IsSome();
        var classes = $"icon-tile art-perk {(cell.Picked ? "picked" : "")} {(blocked ? "blocked" : "")} {(cell.Tile.InRules ? "" : "out")} {(focus == Optional.Some(cell.Perk) ? "focused" : "")}";
        <button type="button" class="@classes" data-hash="@cell.Perk.Value" aria-pressed="@(cell.Picked ? "true" : "false")"
                aria-disabled="@(blocked ? "true" : "false")" title="@DescribePerkTooltip(cell)" aria-label="@cell.Tile.Name"
                @onclick="() => TapPerk(cell)" @onmouseenter="() => FocusPerk(cell.Perk)" @onfocus="() => FocusPerk(cell.Perk)">
            @RenderTileFace(cell.Tile)
            @if (!cell.Tile.InRules)
            {
                <UnsupportedMark />
            }
        </button>
    };

    /// <summary>The focused perk's details, like the game's tooltip.</summary>
    private RenderFragment RenderDetails(ArtifactPerkDetails shown) => __builder =>
    {
        <div class="art-tip @(shown.Picked ? "picked" : "") @(shown.Blocked.IsSome() ? "blocked" : "")" data-testid="artifact-tip">
            <div class="art-tip-head">
                @RenderTile(shown.Tile, "art-tip-icon", false)
                <div class="art-tip-title">
                    <h3 class="art-tip-name">@shown.Tile.Name</h3>
                    <span class="art-tip-kind">@shown.Kind</span>
                </div>
            </div>
            <p class="art-tip-state" data-testid="artifact-tip-state">@shown.State</p>
            @if (shown.Blocked is Optional<string>.Some why)
            {
                <p class="art-tip-why" data-testid="artifact-tip-why">@why.Value</p>
            }
            @if (shown.Tile.GameText.Match(text => text.Value, _ => shown.Tile.Description.UnwrapOr("")) is { Length: > 0 } text)
            {
                <p class="art-tip-text">@text</p>
            }
            @if (!shown.Tile.InRules)
            {
                <p class="art-tip-out"><UnsupportedMark /> Loopsmith has no rules for it yet: it sets nothing off.</p>
            }
            @if (shown.Tile.Details is Optional<ItemDetails>.Some open)
            {
                <button type="button" class="btn ghost small" data-action="artifact-perk-details" @onclick="() => OpenDetails(open.Value)">What it does</button>
            }
        </div>
    };

    /// <summary>The dropdown of every artifact (and none), one per line, floating under ⋯: picking one shows its perks.</summary>
    private RenderFragment RenderArtifactList() => __builder =>
    {
        <div class="sub-drop art-drop" id="@OpenListId" role="group" tabindex="-1" data-testid="artifact-picker" aria-label="Pick an artifact" @onclick:stopPropagation="true">
            <div class="sub-drop-options">
                @RenderArtifactOptions(true)
            </div>
        </div>
    };

    /// <summary>Every artifact, one per line with how many of its perks are picked, and (in the dropdown) "No artifact".</summary>
    private RenderFragment RenderArtifactOptions(bool withNone) => __builder =>
    {
        @foreach (var option in Artifacts)
        {
            var hash = option.Hash;
            var current = artifact == Optional.Some(hash);
            var tile = ArtifactShaping.DescribeArtifact(option);
            <button type="button" class="perk-option @(current ? "picked" : "")" data-hash="@hash.Value" aria-pressed="@(current ? "true" : "false")"
                    title="@option.Name" @onclick="() => SwitchArtifact(Optional.Some(hash))">
                @RenderTile(tile, "perk", false)
                <span class="perk-option-text">
                    <span class="perk-option-name">@option.Name</span>
                    <span class="perk-option-type">@ArtifactShaping.DescribePicked(current ? perks.Length : LoopDesigning.RecallArtifactPerks(Build, remembered, hash).Length)</span>
                </span>
            </button>
        }
        @if (withNone)
        {
            <button type="button" class="perk-option @(artifact.IsSome() ? "" : "picked")" data-action="no-artifact" aria-pressed="@(artifact.IsSome() ? "false" : "true")"
                    @onclick="() => SwitchArtifact(Optional.None<ItemHash>())">
                <span class="icon-tile empty perk" aria-hidden="true"></span>
                <span class="perk-option-text">
                    <span class="perk-option-name">No artifact</span>
                    <span class="perk-option-type">No artifact perks</span>
                </span>
            </button>
        }
    };

    /// <summary>A square: a button that opens its details (tappable), else a plain square.</summary>
    private RenderFragment RenderTile(IconTile tile, string kind, bool tappable) => __builder =>
    {
        var classes = $"icon-tile {kind} {(tile.InRules ? "" : "out")}";
        @if (tappable && tile.Details is Optional<ItemDetails>.Some tileDetails)
        {
            <button type="button" class="@classes tappable" title="@LoadoutShaping.DescribePlugTooltip(tile)" aria-label="@tile.Name" aria-haspopup="dialog" @onclick="() => OpenDetails(tileDetails.Value)">
                @RenderTileFace(tile)
            </button>
        }
        else
        {
            <span class="@classes" title="@LoadoutShaping.DescribePlugTooltip(tile)" aria-label="@tile.Name">
                @RenderTileFace(tile)
                @if (!tile.InRules)
                {
                    <UnsupportedMark />
                }
            </span>
        }
    };

    private RenderFragment RenderTileFace(IconTile tile) => __builder =>
    {
        @if (tile.Icon is Optional<string>.Some icon)
        {
            <img src="@icon.Value" alt="" loading="lazy" />
        }
        else
        {
            <span class="icon-initials">@string.Concat(tile.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(3).Select(word => char.ToUpperInvariant(word[0])))</span>
        }
    };

    private static string DescribePerkTooltip(ArtifactPerkCell cell) =>
        string.Join("\n", new[] { LoadoutShaping.DescribePlugTooltip(cell.Tile), cell.Blocked.Match(why => $"Requirements not met: {why.Value}", _ => "") }.Where(part => part.Length > 0));

    /// <summary>A tap on a perk: an active one is taken out, one that fits is made active; either way its details show.</summary>
    private void TapPerk(ArtifactPerkCell cell)
    {
        focus = Optional.Some(cell.Perk);                                                        // impure (UI state)
        if (cell.Picked)
        {
            perks = perks.Remove(cell.Perk);                                                     // impure (UI state)
        }
        else if (!cell.Blocked.IsSome())
        {
            perks = perks.Add(cell.Perk);                                                        // impure (UI state)
        }
    }

    private void FocusPerk(ItemHash perk) =>
        focus = Optional.Some(perk);                                                             // impure (UI state)

    /// <summary>Another artifact: the perks of the one left are remembered, the new one shows the perks last picked for it (else none).</summary>
    private void SwitchArtifact(Optional<ItemHash> next)
    {
        remembered = artifact.Match(left => remembered.SetItem(left.Value, perks), _ => remembered); // impure (UI state)
        perks = next.Match(found => LoopDesigning.RecallArtifactPerks(Build, remembered, found.Value), _ => ImmutableArray<ItemHash>.Empty); // impure (UI state)
        artifact = next;                                                                         // impure (UI state)
        focus = Optional.None<ItemHash>();                                                       // impure (UI state)
        listOpen = false;                                                                        // impure (UI state)
        refocus = true;                                                                          // impure (UI state)
    }

    /// <summary>The list that just opened is placed under ⋯ (above it when there's no room below) and takes the focus, so
    /// Escape reaches it; one that closed hands the focus back to ⋯.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (placeList && listOpen)
        {
            placeList = false;
            await Browser.PlaceDropdownAsync(OpenListId);                                        // impure
        }
        if (refocus)
        {
            refocus = false;
            await Browser.FocusElementAsync(SwitchButtonId);                                     // impure
        }
    }

    private void ToggleList()
    {
        listOpen = !listOpen;                                                                    // impure (UI state)
        placeList = listOpen;                                                                    // impure (UI state)
    }

    /// <summary>A tap outside the open list (in the editor) closes it.</summary>
    private void CloseList() =>
        listOpen = false;                                                                        // impure (UI state)

    /// <summary>Escape with the list open closes the list only, and the focus goes back to ⋯; with none open it closes the
    /// editor (the editor handles Escape itself, as the subclass editor does).</summary>
    private async Task CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
        {
            return;
        }
        if (listOpen)
        {
            listOpen = false;                                                                    // impure (UI state)
            refocus = true;                                                                      // impure (UI state)
            return;
        }
        await OnClose.InvokeAsync();                                                             // impure
    }

    private void OpenDetails(ItemDetails open) =>
        details = Optional.Some(open);                                                           // impure (UI state)

    private void CloseDetails() =>
        details = Optional.None<ItemDetails>();                                                  // impure (UI state)

    private Task SaveAsync()
    {
        var kept = artifact.Match(found => remembered.SetItem(found.Value, perks), _ => remembered); // pure
        return OnSave.InvokeAsync(new ArtifactSave(new ArtifactChoice(artifact, perks), kept)); // impure
    }
}
