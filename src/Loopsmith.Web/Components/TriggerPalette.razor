@* The next triggers the build offers (LoopDesigning.ListTriggerOptions), laid out like Destiny's HUD
   (TriggerHudShaping): the Super's diamond, the grenade, melee and class ability squares in the subclass's colour, each
   with the secondary uses the build's rules name below it (Tempest Strike's sliding melee, Ascension's air move, Arc Staff's heavy combo: a
   different trigger from the press) (and the finisher's: the equipped finisher's icon after a Bungie login, else the
   class's own), the weapons in their damage type's colour; above them what is on the ground and the states to declare. Tapping the Super,
   an ability or a weapon picks it: its actions show below the HUD — hit or kill, and how many enemies that one action
   catches — and stay there for the next step. One that only has one action (the class ability, its air move, the
   finisher, a pickup, a declared state) acts at once. Every trigger is pickable — except while the build equips nothing
   (a build started from scratch, LoopDesigning.HasTriggerSource): then the panel is greyed out, nothing in it
   can be tapped, and a line says why. *@
@{
    var hud = TriggerHudShaping.ShapeHud(Options, counts, optionsOn, Build, Profile);
    var disabled = !LoopDesigning.HasTriggerSource(Build);
    var picked = disabled ? Optional.None<HudSlot>() : FindPicked(hud);
}
<section class="panel palette @(disabled ? "disabled" : "")" aria-label="Next trigger" aria-disabled="@(disabled ? "true" : "false")">
    <header class="panel-head">
        <h2>Next trigger</h2>
        <span class="panel-caption">@Caption</span>
    </header>
    @if (disabled)
    {
        <p class="palette-disabled" role="status" data-testid="palette-disabled">Equip something first: ⋯ on the Subclass box picks its abilities.</p>
    }
    else if (Hint.Length > 0)
    {
        <p class="palette-hint">@Hint</p>
    }
    <div class="trig-hud aff-@hud.Subclass.ToString().ToLowerInvariant()" data-testid="trigger-hud" inert="@disabled">
        @if (!hud.OnYou.IsEmpty || !hud.CriticalHealth.IsEmpty || !hud.OnWeapons.IsEmpty || !hud.OnPack.IsEmpty || !hud.NewPack.IsEmpty || !hud.Ground.IsEmpty)
        {
            <div class="trig-status" aria-label="States you declare, and what is on the ground">
                @RenderStatuses("you", "On you", hud.OnYou, hud.CriticalHealth)
                @RenderStatuses("weapons", "Your weapons", hud.OnWeapons, [])
                @RenderStatuses("pack", "The pack", hud.OnPack, hud.NewPack)
                @if (!hud.Ground.IsEmpty)
                {
                    <div class="trig-group" data-testid="trig-group" data-group="ground">
                        <span class="trig-group-label">On the ground</span>
                        @foreach (var button in hud.Ground)
                        {
                            @RenderButton(button, "trig-chip", "◆")
                        }
                    </div>
                }
            </div>
        }
        <div class="trig-bar" aria-hidden="true"></div>
        <div class="trig-main">
            <div class="trig-abilities">
                @if (hud.Super is Optional<HudAbility>.Some super)
                {
                    @RenderAbility(super.Value, "trig-super")
                }
                @foreach (var ability in hud.Abilities)
                {
                    @RenderAbility(ability, "trig-ability")
                }
                @if (hud.Finisher is Optional<HudSlot>.Some finisher)
                {
                    @RenderSlot(finisher.Value, "trig-ability trig-finisher", Optional.Some("Finisher"))
                }
            </div>
            <div class="trig-weapons">
                @foreach (var weapon in hud.Weapons)
                {
                    var slot = weapon.Slot;
                    var isPicked = picked.Match(found => found.Value.Choice.Key == slot.Choice.Key, _ => false);
                    <button type="button" class="trig-weapon aff-@slot.Affinity.ToString().ToLowerInvariant() @(isPicked ? "picked" : "")"
                            data-action="trigger-weapon" data-hud-slot="@slot.Choice.Key" aria-pressed="@(isPicked ? "true" : "false")"
                            aria-label="@($"{slot.Name} ({weapon.WeaponSlot})")" title="@slot.Name"
                            @onclick="() => Pick(slot)">
                        <span class="trig-weapon-icon">
                            @if (slot.Face is HudFace.Pictured weaponFace)
                            {
                                <img src="@weaponFace.Icon" alt="" loading="lazy" />
                            }
                        </span>
                        @if (weapon.DamageIcon is Optional<string>.Some damage)
                        {
                            <img class="trig-damage-icon" src="@damage.Value" alt="" loading="lazy" />
                        }
                        <span class="trig-weapon-text">
                            <span class="trig-weapon-name">@slot.Name</span>
                            <span class="trig-weapon-kind">@DescribeWeaponKind(weapon)</span>
                        </span>
                        @if (slot.IsNew)
                        {
                            <span class="trig-new" title="Unlocked by the last step"></span>
                        }
                    </button>
                }
                @if (hud.AmmoBrick is Optional<HudSlot>.Some ammo)
                {
                    @* Bricks drop from enemies, which only play decides: the player picks one up when the loop does (ADRs D43). *@
                    var isAmmoPicked = pickedKey == Optional.Some(ammo.Value.Choice.Key);
                    <button type="button" class="trig-weapon trig-ammo aff-neutral @(isAmmoPicked ? "picked" : "")"
                            data-action="trigger-ammo-brick" data-hud-slot="@ammo.Value.Choice.Key" aria-pressed="@(isAmmoPicked ? "true" : "false")"
                            aria-label="@ammo.Value.Name" title="@ammo.Value.Name"
                            @onclick="() => Pick(ammo.Value)">
                        <span class="trig-weapon-icon trig-ammo-icon" aria-hidden="true">@DomainPhrasing.AmmoBrickIcon</span>
                        <span class="trig-weapon-text">
                            <span class="trig-weapon-name">@ammo.Value.Name</span>
                            <span class="trig-weapon-kind">@string.Join(" · ", Enum.GetNames<AmmoBrick>())</span>
                        </span>
                        @if (ammo.Value.IsNew)
                        {
                            <span class="trig-new" title="Unlocked by the last step"></span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
    <div class="trig-actions" data-testid="trig-actions" aria-live="polite" inert="@disabled">
        @if (picked is Optional<HudSlot>.Some shown)
        {
            var choice = shown.Value.Choice;
            <span class="trig-actions-title" data-testid="trig-actions-title">@shown.Value.Name</span>
            <div class="trigger-buttons" data-testid="trigger-buttons">
                @foreach (var button in choice.Buttons.Where(button => !button.StandsApart))
                {
                    @RenderTrigger(button)
                }
            </div>
            @if (choice.Targets is Optional<TargetCount>.Some targets)
            {
                <label class="target-count" data-testid="target-count" title="How many enemies one hit or kill catches, and what needs that many">
                    <span class="target-count-sign" aria-hidden="true">×</span>
                    <select value="@targets.Value.Value" data-action="target-count" @onchange="e => PickTargetCount(choice.Key, e)"
                            aria-label="@($"{choice.Title}: enemies per hit or kill")">
                        @foreach (var count in ListCounts(choice))
                        {
                            <option value="@count.Value">@count.Text</option>
                        }
                    </select>
                </label>
            }
            @foreach (var toggle in choice.Options)
            {
                <button type="button" class="trig-option @(toggle.IsOn ? "on" : "")" data-action="trigger-option" data-option="@toggle.Option"
                        aria-pressed="@(toggle.IsOn ? "true" : "false")" title="@toggle.Hint"
                        @onclick="() => ToggleOption(choice.Key, toggle.Option)">
                    <span class="trig-option-box" aria-hidden="true">@(toggle.IsOn ? "✓" : "")</span>
                    <span class="trig-option-caption" data-testid="trigger-option-caption">@toggle.Caption</span>
                </button>
            }
            @if (choice.Buttons.Any(button => button.StandsApart))
            {
                @* A reload takes no enemy count and no option (ADRs D37): it stands at the row's right end, away from them. *@
                <div class="trigger-buttons apart" data-testid="trigger-buttons-apart">
                    @foreach (var button in choice.Buttons.Where(button => button.StandsApart))
                    {
                        @RenderTrigger(button)
                    }
                </div>
            }
        }
        else
        {
            <span class="muted">Tap your Super, an ability, a weapon or an ammo brick.</span>
        }
    </div>
</section>

@code {
    private ImmutableDictionary<string, TargetCount> counts = ImmutableDictionary<string, TargetCount>.Empty;
    private ImmutableHashSet<string> optionsOn = ImmutableHashSet<string>.Empty;
    private Optional<string> pickedKey = Optional.None<string>();

    [Parameter, EditorRequired]
    public ValidatedBuild Build { get; set; } = null!;

    [Parameter, EditorRequired]
    public ImmutableArray<TriggerOption> Options { get; set; }

    /// <summary>The state the next step starts in: the counts a row offers are those that still fill something from it.</summary>
    [Parameter, EditorRequired]
    public GameState State { get; set; } = null!;

    /// <summary>The counts last listed, for the row and the state they were listed for (listing plays the step at each count).</summary>
    private (GameState State, PlayerAction Action, ImmutableArray<TargetCountOption> Options)? listedCounts;

    /// <summary>The counts a row offers, listed for its kill (a kill hits too, so it fills the most) when it has one.</summary>
    private ImmutableArray<TargetCountOption> ListCounts(TriggerChoice choice)
    {
        var action = TriggerPaletteShaping.FindCountedAction(choice);
        if (listedCounts is { } listed && ReferenceEquals(listed.State, State) && listed.Action == action)
        {
            return listed.Options;
        }

        var options = TriggerPaletteShaping.ListTargetCountOptions(Build, State, action);       // pure
        listedCounts = (State, action, options);
        return options;
    }

    /// <summary>The player's Bungie profile, after a login: the finisher square shows the finisher they have equipped.</summary>
    [Parameter]
    public Optional<BungieProfile> Profile { get; set; } = Optional.None<BungieProfile>();

    [Parameter]
    public string Caption { get; set; } = "";

    [Parameter]
    public string Hint { get; set; } = "";

    /// <summary>The action to append: the picked option aimed at its row's target count.</summary>
    [Parameter]
    public EventCallback<PlayerAction> OnPick { get; set; }

    /// <summary>The Super, an ability or a weapon: its square (the Super's a diamond), its icon (else its caption, else "?"), a dot when it is new.</summary>
    private RenderFragment RenderSlot(HudSlot slot, string kind) => RenderSlot(slot, kind, Optional.None<string>());

    private RenderFragment RenderSlot(HudSlot slot, string kind, Optional<string> caption) => __builder =>
    {
        var isPicked = pickedKey == Optional.Some(slot.Choice.Key);
        var affinity = slot.Affinity.ToString().ToLowerInvariant();
        @if (slot.AtOnce is Optional<TriggerButton>.Some once)
        {
            <button type="button" class="@kind trigger aff-@affinity @(slot.Face is HudFace.EmptySlot ? "empty" : "")" data-action="trigger-ability" data-hud-slot="@slot.Choice.Key" data-token="@once.Value.Token"
                    aria-label="@($"{slot.Kind}: {slot.Name}")" title="@($"{slot.Kind}: {slot.Name}  ({once.Value.Token})")"
                    @onclick="() => PickTrigger(once.Value.Action)">
                @RenderIcon(slot, caption)
            </button>
        }
        else
        {
            <button type="button" class="@kind aff-@affinity @(isPicked ? "picked" : "") @(slot.Face is HudFace.EmptySlot ? "empty" : "")" data-action="trigger-ability" data-hud-slot="@slot.Choice.Key"
                    aria-pressed="@(isPicked ? "true" : "false")" aria-label="@($"{slot.Kind}: {slot.Name}")" title="@($"{slot.Kind}: {slot.Name}")"
                    @onclick="() => Pick(slot)">
                @RenderIcon(slot, caption)
            </button>
        }
    };

    /// <summary>
    /// A secondary use below its ability's square: the icon of the element that names it and its input ("slide", "air",
    /// "hold"); a tap picks it (its hit and kill show below the HUD), or acts at once when it has one action (the air move).
    /// </summary>
    private RenderFragment RenderSecondary(HudSecondary secondary) => __builder =>
    {
        var slot = secondary.Slot;
        var isPicked = pickedKey == Optional.Some(slot.Choice.Key);
        var affinity = slot.Affinity.ToString().ToLowerInvariant();
        var title = $"{secondary.Gesture}: {secondary.NamedBy}";
        @if (slot.AtOnce is Optional<TriggerButton>.Some once)
        {
            <button type="button" class="trig-secondary trigger aff-@affinity" data-action="trigger-secondary" data-hud-slot="@slot.Choice.Key" data-token="@once.Value.Token"
                    aria-label="@($"{secondary.Gesture}: {slot.Name}")" title="@($"{title}  ({once.Value.Token})")"
                    @onclick="() => PickTrigger(once.Value.Action)">
                @RenderSecondaryFace(secondary)
            </button>
        }
        else
        {
            <button type="button" class="trig-secondary aff-@affinity @(isPicked ? "picked" : "")" data-action="trigger-secondary" data-hud-slot="@slot.Choice.Key"
                    aria-pressed="@(isPicked ? "true" : "false")" aria-label="@($"{secondary.Gesture}: {slot.Name}")" title="@title"
                    @onclick="() => Pick(slot)">
                @RenderSecondaryFace(secondary)
            </button>
        }
    };

    private static RenderFragment RenderSecondaryFace(HudSecondary secondary) => __builder =>
    {
        <span class="trig-secondary-icon" aria-hidden="true">
            @if (secondary.Slot.Face is HudFace.Pictured face)
            {
                <img src="@face.Icon" alt="" loading="lazy" />
            }
        </span>
        <span class="trig-secondary-caption" data-testid="secondary-caption">@secondary.Caption</span>
        @if (secondary.Slot.IsNew)
        {
            <span class="trig-new" title="Unlocked by the last step"></span>
        }
    };

    /// <summary>A slot's icon (else its caption — a finisher has no icon —, else its kind when it is empty, else "?"), and a dot when one of its actions is new.</summary>
    private RenderFragment RenderIcon(HudSlot slot, Optional<string> caption) => __builder =>
    {
        <span class="trig-icon">
            @if (slot.Face is HudFace.Pictured face)
            {
                <img src="@face.Icon" alt="" loading="lazy" />
            }
            else if (caption is Optional<string>.Some text)
            {
                <span class="trig-caption" aria-hidden="true">@text.Value</span>
            }
            else if (slot.Face is HudFace.EmptySlot)
            {
                <span class="trig-caption" aria-hidden="true">@slot.Kind</span>
            }
            else
            {
                <span class="trig-unknown" aria-hidden="true">?</span>
            }
        </span>
        @if (slot.IsNew)
        {
            <span class="trig-new" title="Unlocked by the last step"></span>
        }
    };

    /// <summary>A group of statuses ("On you": Bolt Charge [at max (x10)] [ends]), and its other declarations (a new pack).</summary>
    private RenderFragment RenderStatuses(string group, string label, ImmutableArray<HudStatus> statuses, ImmutableArray<TriggerButton> more) => __builder =>
    {
        @if (!statuses.IsEmpty || !more.IsEmpty)
        {
            <div class="trig-group" data-testid="trig-group" data-group="@group">
                <span class="trig-group-label">@label</span>
                @foreach (var status in statuses)
                {
                    <span class="trig-status-chip aff-@status.Affinity.ToString().ToLowerInvariant()" data-testid="status-chip">
                        <span class="trig-status-name" data-testid="status-name">@status.Name</span>
                        @foreach (var button in status.Buttons)
                        {
                            @RenderButton(button, "trig-mini", "")
                        }
                    </span>
                }
                @foreach (var button in more)
                {
                    @RenderButton(button, "trig-chip", "")
                }
            </div>
        }
    };

    /// <summary>A button of the picked row: "🥊 hit", "💀 kill", "🔄 reload", an ammo brick's "special" and "heavy".</summary>
    private RenderFragment RenderTrigger(TriggerButton button) => __builder =>
    {
        <button type="button" class="trigger" data-action="trigger" data-token="@button.Token" title="@($"{button.Label}  ({button.Token})")"
                @onclick="() => PickTrigger(button.Action)">
            <span class="trigger-caption" data-testid="trigger-caption">@button.Caption</span>
            @if (button.IsNew)
            {
                <span class="badge new" title="Unlocked by the last step">new</span>
            }
        </button>
    };

    /// <summary>A trigger that acts at one tap: a declaration, a new pack, a pickup.</summary>
    private RenderFragment RenderButton(TriggerButton button, string kind, string glyph) => __builder =>
    {
        <button type="button" class="trigger @kind" data-action="trigger-at-once" data-token="@button.Token" title="@($"{button.Label}  ({button.Token})")"
                @onclick="() => PickTrigger(button.Action)">
            @if (glyph.Length > 0)
            {
                <span class="trig-chip-glyph" aria-hidden="true">@glyph</span>
            }
            <span class="trigger-caption" data-testid="trigger-caption">@button.Caption</span>
            @if (button.IsNew)
            {
                <span class="badge new" title="Unlocked by the last step">new</span>
            }
        </button>
    };

    /// <summary>An ability's square (the Super's diamond), with the secondary uses the build's rules name below it.</summary>
    private RenderFragment RenderAbility(HudAbility ability, string shape) => __builder =>
    {
        @if (ability.Secondaries.IsEmpty)
        {
            @RenderSlot(ability.Slot, shape)
        }
        else
        {
            <div class="trig-ability-col">
                @RenderSlot(ability.Slot, shape)
                <div class="trig-secondaries" aria-label="@($"{ability.Slot.Kind}: secondary uses")">
                    @foreach (var secondary in ability.Secondaries)
                    {
                        @RenderSecondary(secondary)
                    }
                </div>
            </div>
        }
    };

    /// <summary>The slot whose actions show below the HUD, while the HUD still offers it.</summary>
    private Optional<HudSlot> FindPicked(TriggerHud hud) =>
        pickedKey.Bind(key => hud.Super.Match(found => new[] { found.Value }, _ => [])
            .Concat(hud.Abilities)
            .SelectMany(ability => ability.Secondaries.Select(secondary => secondary.Slot).Prepend(ability.Slot))
            .Concat(hud.Weapons.Select(weapon => weapon.Slot))
            .Concat(hud.AmmoBrick.Match(found => new[] { found.Value }, _ => []))
            .Where(slot => slot.Choice.Key == key && !slot.AtOnce.IsSome())
            .Select(Optional.Some)
            .FindFirstSome());

    private static string DescribeWeaponKind(HudWeapon weapon) =>
        weapon.Archetype.Match(archetype => $"{weapon.WeaponSlot} · {archetype.Value}", _ => weapon.WeaponSlot.ToString());

    private void Pick(HudSlot slot) =>
        pickedKey = Optional.Some(slot.Choice.Key);                                              // impure (component state)

    private Task PickTrigger(PlayerAction action) =>
        OnPick.InvokeAsync(action);                                                              // impure

    /// <summary>Turns an option of a row (a weapon's shield or precision, an ability's last charge) on or off for its next steps.</summary>
    private void ToggleOption(string rowKey, StepOption option)
    {
        var key = TriggerPaletteShaping.ToOptionKey(rowKey, option);                              // pure
        var updated = optionsOn.Contains(key) ? optionsOn.Remove(key) : optionsOn.Add(key);     // pure
        optionsOn = updated;                                                                     // impure (component state)
    }

    private void PickTargetCount(string key, ChangeEventArgs e)
    {
        var picked = TriggerPaletteShaping.ParseTargetCount(e.Value?.ToString());               // pure
        var updated = picked.Match(count => counts.SetItem(key, count.Value), _ => counts.Remove(key)); // pure
        counts = updated;                                                                        // impure (component state)
    }
}
