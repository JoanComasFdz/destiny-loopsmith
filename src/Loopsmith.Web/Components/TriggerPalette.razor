@* The next triggers the build offers (LoopDesigning.ListTriggerOptions), grouped; hit and kill side by side.
   Every trigger is pickable — the palette does not gate abilities on energy. *@
<section class="panel palette" aria-label="Next trigger">
    <header class="panel-head">
        <h2>Next trigger</h2>
        <span class="panel-caption">@Caption</span>
    </header>
    @if (Hint.Length > 0)
    {
        <p class="palette-hint">@Hint</p>
    }
    @foreach (var group in TriggerPaletteShaping.ShapePalette(Options))
    {
        <h3 class="section-label">@group.Heading</h3>
        <div class="trigger-list">
            @foreach (var choice in group.Choices)
            {
                var isPair = choice.Buttons.Length > 1;
                <div class="trigger-row @(isPair ? "pair" : "single")" data-choice="@choice.Key">
                    @if (isPair)
                    {
                        <span class="trigger-title">@choice.Title</span>
                    }
                    <div class="trigger-buttons">
                        @foreach (var button in choice.Buttons)
                        {
                            var option = button.Option;
                            <button class="trigger @(isPair ? "half" : "whole")"
                                    data-token="@option.Token"
                                    title="@($"{option.Label}  ({option.Token})")"
                                    @onclick="() => PickTrigger(option)">
                                <span class="trigger-caption">@button.Caption</span>
                                @if (option.IsNew)
                                {
                                    <span class="badge new" title="Unlocked by the last step">new</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public ImmutableArray<TriggerOption> Options { get; set; }

    [Parameter]
    public string Caption { get; set; } = "";

    [Parameter]
    public string Hint { get; set; } = "";

    [Parameter]
    public EventCallback<TriggerOption> OnPick { get; set; }

    private Task PickTrigger(TriggerOption option) =>
        OnPick.InvokeAsync(option);
}
