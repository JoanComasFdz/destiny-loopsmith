<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rule viewer (tools/rule-viewer/README.md): reads rules/, writes out/rule-viewer/. A host: its logic is Loopsmith.RuleViewer.Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Loopsmith.RuleViewer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Takes a rule's PNG (the rule option) in the Chromium the e2e tests use. -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Loopsmith.Core\Loopsmith.Core.csproj" />
    <ProjectReference Include="..\Loopsmith.RuleViewer.Core\Loopsmith.RuleViewer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rules page's style and script, put into the page as they are. -->
    <EmbeddedResource Include="Page/rules.css" LogicalName="rules.css" />
    <EmbeddedResource Include="Page/rules.js" LogicalName="rules.js" />
  </ItemGroup>
</Project>
