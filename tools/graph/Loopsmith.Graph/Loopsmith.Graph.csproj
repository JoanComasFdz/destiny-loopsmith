<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rules lanes tool (tools/graph/README.md): reads rules/, writes out/graph/. A host: no logic of its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Loopsmith.Graph</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Loopsmith.Core\Loopsmith.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The lanes page's style and script, put into the page as they are. -->
    <EmbeddedResource Include="Page/lanes.css" LogicalName="lanes.css" />
    <EmbeddedResource Include="Page/lanes.js" LogicalName="lanes.js" />
  </ItemGroup>
</Project>
