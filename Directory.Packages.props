<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core: DUs, value objects, YAML (parsing slices only) -->
    <PackageVersion Include="Dunet" Version="1.16.2" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- The Compendium download (tools/compendium/): reads Google Sheets' HTML pages -->
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <!-- Web host (Blazor WebAssembly) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- End-to-end tests (tests/Loopsmith.Web.E2E). Playwright drives the Chromium the cloud image ships in
         /opt/pw-browsers (chromium-1243; sessions never run `playwright install`): 1.63.0 is the release that expects
         build 1243. If the image's Chromium changes, bump this pin to the Playwright release that matches it. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="JoanComasFdz.AssertingThat" Version="1.0.0" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
  </ItemGroup>
</Project>
